{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "evidence-backed-research-maintainer",
  "version": "1.0.0",
  "scope": {
    "knowledgeGlobs": [
      "knowledge/tools/evidence-backed-research.md",
      "knowledge/concepts/research/evidence-backed-research-dossier.md",
      "knowledge/capabilities/research/conduct-evidence-backed-research.md",
      "knowledge/schemas/research/*.schema.json",
      "knowledge/verifications/research/evidence-backed-research/*.json"
    ],
    "connectorIds": ["evidence-backed-research-agent"],
    "capabilityRefs": ["/capabilities/research/conduct-evidence-backed-research.md"]
  },
  "triggers": [
    { "kind": "schedule", "schedule": "40 8 * * 3" },
    { "kind": "source-change" },
    { "kind": "schema-change" },
    { "kind": "connector-change" },
    { "kind": "failed-execution" },
    { "kind": "manual" }
  ],
  "execution": {
    "kind": "deterministic",
    "runtime": "node >=22.19",
    "entrypoint": "collectors/evidence-backed-research-maintainer/src/index.mjs"
  },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": {
    "mode": "proposal-only",
    "requiresApprovalFor": ["knowledge", "connector", "live-probe"]
  },
  "probePolicy": {
    "allowedEnvironments": ["local"],
    "identityPoolRefs": [],
    "maximumEffect": "none"
  },
  "budgets": { "maxRunsPerDay": 2, "maxCostPerDay": 0, "currency": "CNY" }
}
