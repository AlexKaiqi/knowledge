{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/research/conduct-evidence-backed-research-input.schema.json",
  "title": "ConductEvidenceBackedResearchInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario", "goal", "decision", "questions"],
  "properties": {
    "scenario": {
      "enum": ["demand", "market-competitive", "technical-solution", "academic-frontier", "platform-integration", "distribution-impact"]
    },
    "goal": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "decision": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cutoffAt": { "type": "string", "format": "date-time" },
        "geographies": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "versions": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "exclusions": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSources": { "type": "integer", "minimum": 3, "maximum": 40, "default": 12 },
        "maxQueries": { "type": "integer", "minimum": 1, "maximum": 30, "default": 10 }
      }
    }
  }
}
