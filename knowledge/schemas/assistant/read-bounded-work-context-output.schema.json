{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/assistant/read-bounded-work-context-output.schema.json",
  "title": "BoundedWorkContextProjection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "query", "currentSessionRef", "workspaceRef", "contextText", "contextDigest", "sourceRefs", "coverage", "retention", "sessionHistoryModified", "durableKnowledgeModified", "executionAuthorized", "resultDigest"],
  "properties": {
    "schemaVersion": { "const": "dsh.bounded-work-context/v1" },
    "query": { "type": "string", "maxLength": 500 },
    "currentSessionRef": { "type": "string", "pattern": "^session:[A-Za-z0-9._-]{1,128}$" },
    "workspaceRef": { "type": "string", "pattern": "^workspace:[A-Za-z0-9._-]{1,128}$" },
    "contextText": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "contextDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:\\.pkb/current\\.md|session:[A-Za-z0-9._-]{1,128}|knowledge/[A-Za-z0-9._-]{1,128}\\.md)$" }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budgetChars", "renderedChars", "sourceCount", "priorSessionCount", "durableKnowledgeCount", "currentWorkIncluded", "currentSessionTranscriptIncluded", "rawTranscriptRetained", "projectionComplete"],
      "properties": {
        "budgetChars": { "type": "integer", "minimum": 1200, "maximum": 12000 },
        "renderedChars": { "type": "integer", "minimum": 1, "maximum": 12000 },
        "sourceCount": { "type": "integer", "minimum": 1, "maximum": 12 },
        "priorSessionCount": { "type": "integer", "minimum": 0, "maximum": 11 },
        "durableKnowledgeCount": { "type": "integer", "minimum": 0, "maximum": 11 },
        "currentWorkIncluded": { "const": true },
        "currentSessionTranscriptIncluded": { "const": false },
        "rawTranscriptRetained": { "const": false },
        "projectionComplete": { "const": false }
      }
    },
    "retention": { "const": "ephemeral-only" },
    "sessionHistoryModified": { "const": false },
    "durableKnowledgeModified": { "const": false },
    "executionAuthorized": { "const": false },
    "resultDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
