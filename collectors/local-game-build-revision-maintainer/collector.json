{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "local-game-build-revision-maintainer",
  "version": "1.0.0",
  "scope": {
    "knowledgeGlobs": [
      "knowledge/tools/local-game-build-revision.md",
      "knowledge/concepts/game/local-build-revision.md",
      "knowledge/capabilities/game/prepare-local-build-revision.md",
      "knowledge/schemas/game/*.schema.json",
      "knowledge/verifications/game/local-build-revision/*.json"
    ],
    "connectorIds": ["local-game-build-revision"],
    "capabilityRefs": ["/capabilities/game/prepare-local-build-revision.md"]
  },
  "triggers": [
    { "kind": "schedule", "schedule": "20 10 * * 3" },
    { "kind": "source-change" },
    { "kind": "schema-change" },
    { "kind": "connector-change" },
    { "kind": "failed-execution" },
    { "kind": "manual" }
  ],
  "execution": {
    "kind": "deterministic",
    "runtime": "node >=22.19",
    "entrypoint": "collectors/local-game-build-revision-maintainer/src/index.mjs"
  },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": {
    "mode": "proposal-only",
    "requiresApprovalFor": ["knowledge", "connector", "live-probe"]
  },
  "probePolicy": {
    "allowedEnvironments": ["local", "production-public"],
    "identityPoolRefs": [],
    "maximumEffect": "none"
  },
  "budgets": { "maxRunsPerDay": 2, "maxCostPerDay": 0, "currency": "CNY" }
}
