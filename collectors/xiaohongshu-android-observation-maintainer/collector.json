{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "xiaohongshu-android-observation-maintainer",
  "version": "0.1.0",
  "scope": {
    "knowledgeGlobs": [
      "docs/research/xiaohongshu-integration.md",
      "connectors/xiaohongshu-android-observation/**",
      "probes/definitions/xiaohongshu-android-public-search-live.json"
    ],
    "connectorIds": ["xiaohongshu-android-observation"],
    "capabilityRefs": ["/capabilities/research/search-public-social-content.md"]
  },
  "triggers": [
    { "kind": "schedule", "schedule": "15 9 * * *" },
    { "kind": "source-change" },
    { "kind": "connector-change" },
    { "kind": "failed-execution" },
    { "kind": "manual" }
  ],
  "execution": {
    "kind": "deterministic",
    "runtime": "node >=22.19; optional local Android platform-tools",
    "entrypoint": "collectors/xiaohongshu-android-observation-maintainer/src/index.mjs"
  },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": {
    "mode": "proposal-only",
    "requiresApprovalFor": ["knowledge", "connector", "identity", "credential", "live-probe"]
  },
  "probePolicy": {
    "allowedEnvironments": ["production-private"],
    "identityPoolRefs": ["identity-pool:xiaohongshu-owned-probes"],
    "maximumEffect": "none"
  },
  "budgets": {
    "maxRunsPerDay": 2,
    "maxCostPerDay": 0,
    "currency": "USD"
  }
}
