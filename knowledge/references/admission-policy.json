{
  "schemaVersion": "dsh.knowledge-admission-policy/v1",
  "requirePassedReport": true,
  "requireFreshReport": true,
  "requireFreshKnowledge": true,
  "requireSources": true,
  "requireVerified": true,
  "rejectOrphans": true,
  "valueAlignment": {
    "capabilityOutcomeField": "outcomes",
    "acceptedOutcomeDomains": [
      "demand-discovery",
      "product-research",
      "content-publishing",
      "app-publishing",
      "research-publishing",
      "distribution",
      "feedback-collection",
      "influence-measurement"
    ],
    "rejectGenericInfrastructure": true
  },
  "subjectTypes": {
    "Tool": { "acceptedVerificationLevels": ["local", "sandbox", "live"] },
    "Platform": { "acceptedVerificationLevels": ["sandbox", "live"] },
    "Information Source": { "acceptedVerificationLevels": ["sandbox", "live"] },
    "Dataset": { "acceptedVerificationLevels": ["sandbox", "live"] },
    "Service": { "acceptedVerificationLevels": ["sandbox", "live"] },
    "Protocol": { "acceptedVerificationLevels": ["sandbox", "live"] }
  }
}
