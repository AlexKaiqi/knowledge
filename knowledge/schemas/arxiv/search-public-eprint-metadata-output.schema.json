{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/schemas/arxiv/search-public-eprint-metadata-output.schema.json",
  "title": "Public arXiv e-print metadata search page",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "query", "coverage", "entries", "observedAt", "collectedAt", "resultDigest", "conformance"],
  "properties": {
    "source": {
      "type": "object", "additionalProperties": false, "required": ["id", "documentation", "terms"],
      "properties": {
        "id": { "const": "arxiv-public-metadata-api" },
        "documentation": { "const": "https://info.arxiv.org/help/api/user-manual.html" },
        "terms": { "const": "https://info.arxiv.org/help/api/tou.html" }
      }
    },
    "query": {
      "type": "object", "additionalProperties": false,
      "required": ["query", "field", "category", "sortBy", "sortOrder", "start", "limit"],
      "properties": {
        "query": { "type": "string", "minLength": 2, "maxLength": 200 },
        "field": { "enum": ["all", "title", "abstract"] },
        "category": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*(?:\\.[A-Za-z0-9-]+)?$" },
        "sortBy": { "enum": ["relevance", "lastUpdatedDate", "submittedDate"] },
        "sortOrder": { "enum": ["ascending", "descending"] },
        "start": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["representation", "totalResults", "startIndex", "itemsPerPage", "returnedCount", "corpusComplete", "resultSetMutable", "checkpointSemantics", "metadataOnly", "contentFilesRetained"],
      "properties": {
        "representation": { "const": "offset-page" },
        "totalResults": { "type": "integer", "minimum": 0 },
        "startIndex": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "itemsPerPage": { "type": "integer", "minimum": 0, "maximum": 20 },
        "returnedCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "corpusComplete": { "type": "boolean" },
        "resultSetMutable": { "const": true },
        "checkpointSemantics": { "const": "offset-is-not-stable-delta" },
        "metadataOnly": { "const": true },
        "contentFilesRetained": { "const": false }
      }
    },
    "entries": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["arxivId", "title", "summary", "authors", "publishedAt", "updatedAt", "primaryCategory", "categories", "abstractUrl", "pdfUrl", "comment", "journalReference", "doi"],
        "properties": {
          "arxivId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "title": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 20000 },
          "authors": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
          "publishedAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "primaryCategory": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[A-Za-z0-9-]+)?$" },
          "categories": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[A-Za-z0-9-]+)?$" } },
          "abstractUrl": { "type": "string", "format": "uri", "pattern": "^https://arxiv\\.org/abs/" },
          "pdfUrl": { "type": "string", "format": "uri", "pattern": "^https://arxiv\\.org/pdf/" },
          "comment": { "type": ["string", "null"], "maxLength": 4000 },
          "journalReference": { "type": ["string", "null"], "maxLength": 4000 },
          "doi": { "type": ["string", "null"], "maxLength": 512 }
        }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "collectedAt": { "type": "string", "format": "date-time" },
    "resultDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "conformance": {
      "type": "object", "additionalProperties": false, "required": ["status", "assertions"],
      "properties": {
        "status": { "enum": ["passed", "review-required"] },
        "assertions": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "passed"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "passed": { "type": "boolean" } } } }
      }
    }
  }
}
