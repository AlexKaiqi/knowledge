{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/steam/prepare-system-requirements-review-revision-input.schema.json",
  "title": "PrepareSteamSystemRequirementsReviewRevisionInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["gameRef", "sourceRevisionRef", "buildRevisionRef", "platforms"],
  "properties": {
    "gameRef": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,191}$" },
    "sourceRevisionRef": { "$ref": "#/$defs/ref" },
    "buildRevisionRef": { "$ref": "#/$defs/ref" },
    "platforms": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": { "$ref": "#/$defs/platform" }
    }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "refs10": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "refs20": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "value", "evidenceRefs"],
      "properties": {
        "field": { "enum": ["os", "processor", "memory", "graphics", "directx", "network", "storage", "sound-card", "additional-notes"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidenceRefs": { "$ref": "#/$defs/refs10" }
      }
    },
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "buildArtifactRef", "depotRefs", "publicPackageRefs", "launchTestRefs", "minimum", "recommended"],
      "properties": {
        "platform": { "enum": ["windows", "macos", "linux-steamos"] },
        "buildArtifactRef": { "$ref": "#/$defs/ref" },
        "depotRefs": { "$ref": "#/$defs/refs10" },
        "publicPackageRefs": { "$ref": "#/$defs/refs10" },
        "launchTestRefs": { "$ref": "#/$defs/refs20" },
        "minimum": { "type": "array", "minItems": 1, "maxItems": 9, "items": { "$ref": "#/$defs/requirement" } },
        "recommended": { "type": "array", "maxItems": 9, "items": { "$ref": "#/$defs/requirement" } }
      }
    }
  }
}
