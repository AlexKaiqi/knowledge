{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "osv-public-advisory-maintainer",
  "version": "1.0.0",
  "scope": {
    "knowledgeGlobs": ["knowledge/sources/osv.md", "knowledge/concepts/osv/public-advisory.md", "knowledge/capabilities/osv/read-public-advisory.md", "knowledge/schemas/osv/read-public-advisory-*.schema.json", "knowledge/verifications/osv/public-advisory/*.json"],
    "connectorIds": ["osv-public-advisory"],
    "capabilityRefs": ["/capabilities/osv/read-public-advisory.md"]
  },
  "triggers": [{ "kind": "schedule", "schedule": "0 9 * * *" }, { "kind": "source-change" }, { "kind": "schema-change" }, { "kind": "connector-change" }, { "kind": "failed-execution" }, { "kind": "manual" }],
  "execution": { "kind": "deterministic", "runtime": "node >=22.19", "entrypoint": "collectors/osv-public-advisory-maintainer/src/index.mjs" },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": { "mode": "proposal-only", "requiresApprovalFor": ["knowledge", "connector", "live-probe"] },
  "probePolicy": { "allowedEnvironments": ["production-public"], "identityPoolRefs": [], "maximumEffect": "none" },
  "budgets": { "maxRunsPerDay": 4, "maxCostPerDay": 0, "currency": "CNY" }
}
