{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "public-state-pet-behavior-maintainer",
  "version": "1.0.0",
  "scope": {
    "knowledgeGlobs": [
      "knowledge/tools/public-state-pet-behavior-projector.md",
      "knowledge/concepts/pet/public-state-behavior-plan.md",
      "knowledge/capabilities/pet/project-public-state-to-behavior.md",
      "knowledge/schemas/pet/*.schema.json",
      "knowledge/verifications/pet/public-state-behavior/*.json"
    ],
    "connectorIds": ["public-state-pet-behavior-projector"],
    "capabilityRefs": ["/capabilities/pet/project-public-state-to-behavior.md"]
  },
  "triggers": [
    { "kind": "schedule", "schedule": "20 9 * * 3" },
    { "kind": "source-change" },
    { "kind": "schema-change" },
    { "kind": "connector-change" },
    { "kind": "failed-execution" },
    { "kind": "manual" }
  ],
  "execution": {
    "kind": "deterministic",
    "runtime": "node >=22.19",
    "entrypoint": "collectors/public-state-pet-behavior-maintainer/src/index.mjs"
  },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": {
    "mode": "proposal-only",
    "requiresApprovalFor": ["knowledge", "connector", "live-probe"]
  },
  "probePolicy": {
    "allowedEnvironments": ["local", "production-public"],
    "identityPoolRefs": [],
    "maximumEffect": "none"
  },
  "budgets": { "maxRunsPerDay": 2, "maxCostPerDay": 0, "currency": "CNY" }
}
