{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/steam/prepare-supported-feature-review-revision-output.schema.json",
  "title": "SteamSupportedFeatureReviewRevision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gameRef", "sourceRevisionRef", "buildRevisionRef", "featureCatalogRevisionRef", "policyRevision", "manualReview", "platformValidated", "buildValidatedByConnector", "savedToSteamworks", "previewedOnSteam", "published", "markedReadyForReview", "released", "executionAuthorized", "preparedAt", "status", "revisionHash", "features", "preflight"],
  "properties": {
    "schemaVersion": { "const": "dsh.steam-supported-feature-review-revision/v1" },
    "gameRef": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,191}$" },
    "sourceRevisionRef": { "$ref": "#/$defs/ref" },
    "buildRevisionRef": { "$ref": "#/$defs/ref" },
    "featureCatalogRevisionRef": { "$ref": "#/$defs/ref" },
    "policyRevision": { "const": "steam-supported-features-2026-08-27" },
    "status": { "enum": ["ready-for-human-review", "blocked"] },
    "revisionHash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "features": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["featureRef", "displayName", "implementationState", "implementationEvidenceRefs", "testEvidenceRefs"],
        "properties": {
          "featureRef": { "$ref": "#/$defs/ref" },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "implementationState": { "const": "implemented-current-build" },
          "implementationEvidenceRefs": { "$ref": "#/$defs/refs" },
          "testEvidenceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "manualReview": {
      "type": "object", "additionalProperties": false, "required": ["required", "checks"],
      "properties": {
        "required": { "const": true },
        "checks": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "status"],
            "properties": {
              "id": { "enum": ["current-platform-feature-availability", "feature-selection-matches-current-catalog", "implementation-evidence-quality", "test-evidence-represents-current-public-build", "feature-is-usable-as-storefront-claims", "owned-target-authority"] },
              "status": { "const": "pending" }
            }
          }
        }
      }
    },
    "preflight": {
      "type": "object", "additionalProperties": false, "required": ["checks", "blockers"],
      "properties": {
        "checks": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "status"],
            "properties": {
              "id": { "enum": ["feature-set-present", "unique-feature-refs", "unique-feature-names", "current-build-implementation-declared", "implementation-evidence-bound", "test-evidence-bound"] },
              "status": { "enum": ["passed", "failed"] }
            }
          }
        },
        "blockers": {
          "type": "array", "maxItems": 90,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["code"],
            "properties": {
              "code": { "enum": ["planned-feature-cannot-be-selected", "feature-implementation-unknown", "duplicate-feature-ref", "duplicate-feature-name"] },
              "featureRef": { "$ref": "#/$defs/ref" },
              "displayName": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          }
        }
      }
    },
    "platformValidated": { "const": false },
    "buildValidatedByConnector": { "const": false },
    "savedToSteamworks": { "const": false },
    "previewedOnSteam": { "const": false },
    "published": { "const": false },
    "markedReadyForReview": { "const": false },
    "released": { "const": false },
    "executionAuthorized": { "const": false },
    "preparedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ready-for-human-review" } } },
      "then": {
        "properties": {
          "revisionHash": { "$ref": "#/$defs/digest" },
          "features": { "minItems": 1 },
          "preflight": { "properties": { "blockers": { "maxItems": 0 } } }
        }
      },
      "else": {
        "properties": {
          "revisionHash": { "type": "null" },
          "features": { "maxItems": 0 },
          "preflight": { "properties": { "blockers": { "minItems": 1 } } }
        }
      }
    }
  ],
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n\\u0000]+$" },
    "refs": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
