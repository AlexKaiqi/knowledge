{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/research/conduct-evidence-backed-research-output.schema.json",
  "title": "EvidenceBackedResearchDossier",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario", "question", "decision", "answer", "confidence", "findings", "evidence", "conflicts", "gaps", "counterEvidenceSearch", "nextProbes", "coverage", "observedAt", "resultDigest", "conformance"],
  "properties": {
    "scenario": {
      "enum": ["demand", "market-competitive", "technical-solution", "academic-frontier", "platform-integration", "distribution-impact"]
    },
    "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "decision": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "answer": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "confidence": { "enum": ["low", "medium", "high"] },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "status", "confidence", "evidenceIds", "counterEvidenceIds", "applicability", "inference"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "claim": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "status": { "enum": ["supported", "suggestive", "conflicting", "unknown"] },
          "confidence": { "enum": ["low", "medium", "high"] },
          "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "counterEvidenceIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "applicability": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "inference": { "type": "boolean" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "sourceType", "weight", "title", "resource", "claim", "locator", "observedAt", "digest"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "role": { "enum": ["problem-evidence", "solution-evidence", "implementation-evidence", "research-claim", "benchmark", "official-boundary", "market-signal", "platform-signal", "counter-evidence"] },
          "sourceType": { "enum": ["official-document", "repository", "work-item", "paper", "review", "community", "dataset", "experiment", "analytics", "interview", "provided-artifact"] },
          "weight": { "enum": ["primary", "independent", "secondary"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "resource": { "type": "string", "format": "uri" },
          "claim": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "locator": { "type": "string", "minLength": 1, "maxLength": 500 },
          "publishedAt": { "type": ["string", "null"], "format": "date-time" },
          "observedAt": { "type": "string", "format": "date-time" },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "evidenceIds", "resolution"],
        "properties": {
          "claim": { "type": "string", "minLength": 1, "maxLength": 1500 },
          "evidenceIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "resolution": { "type": "string", "minLength": 1, "maxLength": 1500 }
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "counterEvidenceSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "queries", "outcome", "evidenceIds"],
      "properties": {
        "performed": { "const": true },
        "queries": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "outcome": { "enum": ["found", "none-found", "inconclusive"] },
        "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "nextProbes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis", "method", "success", "failure", "effect"],
        "properties": {
          "hypothesis": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "method": { "type": "string", "minLength": 1, "maxLength": 1500 },
          "success": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "failure": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "effect": { "enum": ["none", "local-write", "platform-write", "financial", "communication", "identity-relationship"] }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredRoles", "coveredRoles", "sourceCount", "queryCount", "cutoffAt", "stoppedBecause", "complete"],
      "properties": {
        "requiredRoles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/role" } },
        "coveredRoles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/role" } },
        "sourceCount": { "type": "integer", "minimum": 1, "maximum": 40 },
        "queryCount": { "type": "integer", "minimum": 1, "maximum": 30 },
        "cutoffAt": { "type": "string", "format": "date-time" },
        "stoppedBecause": { "enum": ["decision-sufficient", "budget-exhausted", "source-exhausted", "access-blocked"] },
        "complete": { "type": "boolean" }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "resultDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assertions"],
      "properties": {
        "status": { "enum": ["passed", "review-required"] },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "passed": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "role": { "enum": ["problem-evidence", "solution-evidence", "implementation-evidence", "research-claim", "benchmark", "official-boundary", "market-signal", "platform-signal", "counter-evidence"] }
  }
}
