{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/connector-definition.schema.json",
  "title": "ConnectorDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "capabilityRefs", "execution", "configSchema", "credentialSlots", "handlers", "conformance"],
  "properties": {
    "schemaVersion": { "const": "dsh.connector-definition/v1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "minLength": 1 },
    "capabilityRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/localRef" } },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runtime", "entrypoint"],
      "properties": {
        "kind": { "enum": ["deterministic", "agentic", "hybrid", "manual"] },
        "runtime": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "pattern": "^connectors/[a-z0-9._-]+/[^/].+$" },
        "modelRouteRef": { "type": "string", "minLength": 1 },
        "promptRef": { "type": "string", "minLength": 1 },
        "toolRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evalRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["agentic", "hybrid"] } }, "required": ["kind"] },
          "then": { "required": ["modelRouteRef", "promptRef", "evalRefs"] }
        }
      ]
    },
    "configSchema": { "type": "string", "minLength": 1 },
    "accessRouteCatalog": { "$ref": "#/$defs/repositoryRef" },
    "credentialSlots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required"],
        "properties": {
          "name": { "$ref": "#/$defs/id" },
          "required": { "type": "boolean" },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "handlers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityRef", "operation"],
        "properties": {
          "capabilityRef": { "$ref": "#/$defs/localRef" },
          "operation": { "type": "string", "minLength": 1 },
          "conformance": { "$ref": "#/$defs/conformance" }
        }
      }
    },
    "conformance": { "$ref": "#/$defs/conformance" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "localRef": { "type": "string", "pattern": "^/(?!/)(?!.*\\.\\.)[^?#]+$" },
    "repositoryRef": { "type": "string", "pattern": "^repo:/(?!/)(?!.*\\.\\.)[^?#]+$" },
    "conformance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "probeDefinitionRef"],
          "properties": {
            "status": { "const": "candidate" },
            "probeDefinitionRef": { "$ref": "#/$defs/repositoryRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "probeReportRef"],
          "properties": {
            "status": { "const": "verified" },
            "probeReportRef": { "$ref": "#/$defs/localRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "enum": ["suspended", "retired"] },
            "reason": { "type": "string", "minLength": 1 },
            "lastProbeReportRef": { "$ref": "#/$defs/localRef" }
          }
        }
      ]
    }
  }
}
