{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/go/read-authenticated-public-module-version-output.schema.json",
  "title": "AuthenticatedPublicGoModuleVersionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "request", "moduleVersion", "authentication", "transfer", "registryState", "observedAt", "resultDigest", "conformance"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "proxyBaseUrl", "checksumDatabase"],
      "properties": {
        "id": { "const": "go-public-module-version" },
        "proxyBaseUrl": { "const": "https://proxy.golang.org" },
        "checksumDatabase": { "const": "sum.golang.org" }
      }
    },
    "request": { "$ref": "#/$defs/request" },
    "moduleVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modulePath", "version", "publishedAt", "versionMetadataAuthentication", "moduleTreeH1", "goMod"],
      "properties": {
        "modulePath": { "type": "string", "minLength": 3, "maxLength": 512 },
        "version": { "type": "string", "minLength": 6, "maxLength": 128 },
        "publishedAt": { "type": ["string", "null"], "format": "date-time" },
        "versionMetadataAuthentication": { "const": "transport-only" },
        "moduleTreeH1": { "$ref": "#/$defs/h1" },
        "goMod": {
          "type": "object",
          "additionalProperties": false,
          "required": ["moduleDirective", "content", "sizeBytes", "sha256", "h1"],
          "properties": {
            "moduleDirective": { "type": "string", "minLength": 3, "maxLength": 512 },
            "content": { "type": "string", "maxLength": 262144 },
            "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "h1": { "$ref": "#/$defs/h1" }
          }
        }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "verifier", "checksumDatabase", "moduleTreeAuthenticated", "goModAuthenticated"],
      "properties": {
        "status": { "const": "authenticated" },
        "method": { "const": "go-command-sumdb" },
        "verifier": { "type": "string", "pattern": "^go[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
        "checksumDatabase": { "const": "sum.golang.org" },
        "moduleTreeAuthenticated": { "const": true },
        "goModAuthenticated": { "const": true }
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archiveSizeBytes", "archiveDownloaded", "archiveExecuted", "cacheScope", "cacheRemoved"],
      "properties": {
        "archiveSizeBytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "archiveDownloaded": { "const": true },
        "archiveExecuted": { "const": false },
        "cacheScope": { "const": "ephemeral" },
        "cacheRemoved": { "const": true }
      }
    },
    "registryState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archiveEtag", "cacheControl"],
      "properties": {
        "archiveEtag": { "type": ["string", "null"] },
        "cacheControl": { "type": ["string", "null"] }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "resultDigest": { "$ref": "#/$defs/sha256" },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assertions"],
      "properties": {
        "status": { "enum": ["passed", "review-required"] },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "passed": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modulePath", "version", "publicModuleAcknowledged"],
      "properties": {
        "modulePath": { "type": "string", "minLength": 3, "maxLength": 512 },
        "version": { "type": "string", "minLength": 6, "maxLength": 128 },
        "publicModuleAcknowledged": { "const": true }
      }
    },
    "h1": { "type": "string", "pattern": "^h1:[A-Za-z0-9+/]{43}=$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
