{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "docker-hub-public-image-manifest-maintainer",
  "version": "1.0.0",
  "scope": {
    "knowledgeGlobs": [
      "knowledge/platforms/docker-hub.md",
      "knowledge/concepts/docker-hub/public-image-manifest.md",
      "knowledge/capabilities/docker-hub/read-public-image-manifest-by-digest.md",
      "knowledge/schemas/docker-hub/read-public-image-manifest-by-digest-*.schema.json",
      "knowledge/verifications/docker-hub/public-image-manifest/*.json"
    ],
    "connectorIds": ["docker-hub-public-image-manifest"],
    "capabilityRefs": ["/capabilities/docker-hub/read-public-image-manifest-by-digest.md"]
  },
  "triggers": [
    { "kind": "schedule", "schedule": "40 7 * * *" },
    { "kind": "source-change" },
    { "kind": "schema-change" },
    { "kind": "connector-change" },
    { "kind": "failed-execution" },
    { "kind": "manual" }
  ],
  "execution": {
    "kind": "deterministic",
    "runtime": "node >=22.19",
    "entrypoint": "collectors/docker-hub-public-image-manifest-maintainer/src/index.mjs"
  },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": { "mode": "proposal-only", "requiresApprovalFor": ["knowledge", "connector", "live-probe"] },
  "probePolicy": { "allowedEnvironments": ["production-public"], "identityPoolRefs": [], "maximumEffect": "none" },
  "budgets": { "maxRunsPerDay": 2, "maxCostPerDay": 0, "currency": "CNY" }
}
