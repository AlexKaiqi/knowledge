{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/pypi/read-public-project-release-output.schema.json",
  "title": "PyPIPublicProjectReleaseResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "request", "release", "distributions", "registryState", "observedAt", "resultDigest", "conformance"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "apiBaseUrl"],
      "properties": {
        "id": { "const": "pypi-public-project-release" },
        "apiBaseUrl": { "const": "https://pypi.org" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectName", "version"],
      "properties": {
        "projectName": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalProjectName", "publishedProjectName", "version", "summary", "requiresPython", "licenseExpression", "licenseClassifiers", "projectUrls", "yanked", "yankedReason", "knownVulnerabilityCount"],
      "properties": {
        "canonicalProjectName": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "publishedProjectName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": ["string", "null"] },
        "requiresPython": { "type": ["string", "null"], "maxLength": 512 },
        "licenseExpression": { "type": ["string", "null"], "maxLength": 512 },
        "licenseClassifiers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^License :: " } },
        "projectUrls": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "url": { "type": "string", "format": "uri", "pattern": "^https://" }
            }
          }
        },
        "yanked": { "type": "boolean" },
        "yankedReason": { "type": ["string", "null"] },
        "knownVulnerabilityCount": { "type": "integer", "minimum": 0 }
      }
    },
    "distributions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filename", "packageType", "pythonVersion", "requiresPython", "sizeBytes", "uploadedAt", "yanked", "yankedReason", "url", "sha256", "blake2b256", "coreMetadataSha256"],
        "properties": {
          "filename": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\\\r\\n]+$" },
          "packageType": { "type": "string", "minLength": 1 },
          "pythonVersion": { "type": "string", "minLength": 1 },
          "requiresPython": { "type": ["string", "null"], "maxLength": 512 },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "uploadedAt": { "type": "string", "format": "date-time" },
          "yanked": { "type": "boolean" },
          "yankedReason": { "type": ["string", "null"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https://files\\.pythonhosted\\.org/" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "blake2b256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "coreMetadataSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "registryState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastSerial", "etag", "cacheControl"],
      "properties": {
        "lastSerial": { "type": "integer", "minimum": 0 },
        "etag": { "type": ["string", "null"] },
        "cacheControl": { "type": ["string", "null"] }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "resultDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assertions"],
      "properties": {
        "status": { "enum": ["passed", "review-required"] },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "passed": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
