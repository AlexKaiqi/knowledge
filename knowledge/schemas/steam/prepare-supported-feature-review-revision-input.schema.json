{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/steam/prepare-supported-feature-review-revision-input.schema.json",
  "title": "PrepareSteamSupportedFeatureReviewRevisionInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["gameRef", "sourceRevisionRef", "buildRevisionRef", "featureCatalogRevisionRef", "features"],
  "properties": {
    "gameRef": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,191}$" },
    "sourceRevisionRef": { "$ref": "#/$defs/ref" },
    "buildRevisionRef": { "$ref": "#/$defs/ref" },
    "featureCatalogRevisionRef": { "$ref": "#/$defs/ref" },
    "features": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["featureRef", "displayName", "implementationState", "implementationEvidenceRefs", "testEvidenceRefs"],
        "properties": {
          "featureRef": { "$ref": "#/$defs/ref" },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "implementationState": { "enum": ["implemented-current-build", "planned-not-released", "unknown"] },
          "implementationEvidenceRefs": { "$ref": "#/$defs/refs" },
          "testEvidenceRefs": { "$ref": "#/$defs/refs" }
        }
      }
    }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n\\u0000]+$" },
    "refs": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } }
  }
}
