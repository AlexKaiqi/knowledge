{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "steam-initial-release-date-revision-maintainer",
  "version": "1.0.0",
  "scope": {
    "knowledgeGlobs": [
      "knowledge/tools/steam-initial-release-date-revision.md",
      "knowledge/concepts/steam/initial-release-date-review-revision.md",
      "knowledge/capabilities/steam/prepare-initial-release-date-review-revision.md",
      "knowledge/schemas/steam/prepare-initial-release-date-review-revision-*.schema.json",
      "knowledge/verifications/steam/initial-release-date-review-revision/*.json"
    ],
    "connectorIds": ["steam-initial-release-date-revision"],
    "capabilityRefs": ["/capabilities/steam/prepare-initial-release-date-review-revision.md"]
  },
  "triggers": [
    { "kind": "schedule", "schedule": "40 10 * * 4" },
    { "kind": "source-change" },
    { "kind": "schema-change" },
    { "kind": "connector-change" },
    { "kind": "failed-execution" },
    { "kind": "manual" }
  ],
  "execution": { "kind": "deterministic", "runtime": "node >=22.19", "entrypoint": "collectors/steam-initial-release-date-revision-maintainer/src/index.mjs" },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": { "mode": "proposal-only", "requiresApprovalFor": ["knowledge", "connector", "live-probe"] },
  "probePolicy": { "allowedEnvironments": ["local", "production-public"], "identityPoolRefs": [], "maximumEffect": "none" },
  "budgets": { "maxRunsPerDay": 2, "maxCostPerDay": 0, "currency": "CNY" }
}
