{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/schemas/steam/prepare-store-asset-review-revision-input.schema.json",
  "title": "Prepare Steam store asset review revision input",
  "type": "object",
  "additionalProperties": false,
  "required": ["gameRef", "sourceRevisionRef", "sourceDirectory", "assets", "rightsBasisRefs"],
  "properties": {
    "gameRef": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,191}$" },
    "sourceRevisionRef": { "$ref": "#/$defs/opaqueRef" },
    "sourceDirectory": { "$ref": "#/$defs/relativePath" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": { "enum": ["header-capsule", "small-capsule", "main-capsule", "vertical-capsule", "screenshot"] },
          "path": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "rightsBasisRefs": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/opaqueRef" } }
  },
  "$defs": {
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$" },
    "opaqueRef": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
