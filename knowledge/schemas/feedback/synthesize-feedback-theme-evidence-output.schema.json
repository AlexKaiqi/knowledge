{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/schemas/feedback/synthesize-feedback-theme-evidence-output.schema.json",
  "title": "Feedback theme evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "question", "decision", "targetRef", "answer", "themes", "conflicts", "gaps", "counterSearch", "unassignedEvidenceRefs", "nextProbes", "sample", "observedAt", "humanReviewRequired", "executionAuthorized", "resultDigest", "conformance"],
  "properties": {
    "schemaVersion": { "const": "dsh.feedback-theme-evidence/v1" },
    "question": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "decision": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "targetRef": { "$ref": "#/$defs/ref" },
    "answer": { "type": "string", "minLength": 1, "maxLength": 3000 },
    "themes": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "problemStatement", "workflow", "supportEvidenceRefs", "counterEvidenceRefs", "affectedRevisionRefs", "confidence", "frequency", "inference"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "problemStatement": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "workflow": { "type": "string", "minLength": 1, "maxLength": 800 },
          "supportEvidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
          "counterEvidenceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
          "affectedRevisionRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
          "confidence": { "enum": ["low", "medium", "high"] },
          "frequency": {
            "type": "object", "additionalProperties": false,
            "required": ["supportingEvidenceCount", "consideredEvidenceCount", "interpretation"],
            "properties": {
              "supportingEvidenceCount": { "type": "integer", "minimum": 1, "maximum": 100 },
              "consideredEvidenceCount": { "type": "integer", "minimum": 2, "maximum": 100 },
              "interpretation": { "const": "sample-only" }
            }
          },
          "inference": { "const": true }
        }
      }
    },
    "conflicts": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["statement", "evidenceRefs", "treatment"],
        "properties": {
          "statement": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "evidenceRefs": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
          "treatment": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "gaps": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 800 } },
    "counterSearch": {
      "type": "object", "additionalProperties": false, "required": ["performed", "evidenceRefs", "outcome"],
      "properties": {
        "performed": { "const": true },
        "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "outcome": { "type": "string", "minLength": 1, "maxLength": 800 }
      }
    },
    "unassignedEvidenceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "nextProbes": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["hypothesis", "method", "success", "failure", "effect"],
        "properties": {
          "hypothesis": { "type": "string", "minLength": 1, "maxLength": 800 },
          "method": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "success": { "type": "string", "minLength": 1, "maxLength": 800 },
          "failure": { "type": "string", "minLength": 1, "maxLength": 800 },
          "effect": { "const": "none" }
        }
      }
    },
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["observedFrom", "observedTo", "completeness", "sourceRefs", "consideredEvidenceCount"],
      "properties": {
        "observedFrom": { "type": "string", "format": "date-time" },
        "observedTo": { "type": "string", "format": "date-time" },
        "completeness": { "enum": ["partial", "complete"] },
        "sourceRefs": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "consideredEvidenceCount": { "type": "integer", "minimum": 2, "maximum": 100 }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "humanReviewRequired": { "const": true },
    "executionAuthorized": { "const": false },
    "resultDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "conformance": {
      "type": "object", "additionalProperties": false, "required": ["status", "assertions"],
      "properties": {
        "status": { "enum": ["passed", "review-required"] },
        "assertions": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "additionalProperties": false, "required": ["id", "passed"], "properties": { "id": { "$ref": "#/$defs/id" }, "passed": { "type": "boolean" } } }
        }
      }
    }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  }
}
