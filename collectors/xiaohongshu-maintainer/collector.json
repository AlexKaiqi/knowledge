{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "xiaohongshu-maintainer",
  "version": "0.2.0",
  "scope": {
    "knowledgeGlobs": [
      "knowledge/platforms/xiaohongshu.md",
      "knowledge/concepts/xiaohongshu/*.md",
      "knowledge/capabilities/xiaohongshu/*.md",
      "knowledge/verifications/xiaohongshu/**/*.json"
    ],
    "connectorIds": ["xiaohongshu-browser"],
    "capabilityRefs": [
      "/capabilities/xiaohongshu/publish-private-note-and-observe.md"
    ]
  },
  "triggers": [
    { "kind": "schedule", "schedule": "0 6 * * *" },
    { "kind": "source-change" },
    { "kind": "connector-change" },
    { "kind": "failed-execution" },
    { "kind": "manual" }
  ],
  "execution": {
    "kind": "deterministic",
    "runtime": "node >=22.19",
    "entrypoint": "collectors/xiaohongshu-maintainer/src/index.mjs"
  },
  "outputs": [
    "knowledge-proposal",
    "connector-change-proposal",
    "verification-report"
  ],
  "writePolicy": {
    "mode": "proposal-only",
    "requiresApprovalFor": [
      "knowledge",
      "connector",
      "identity",
      "credential",
      "live-probe"
    ]
  },
  "probePolicy": {
    "allowedEnvironments": ["local", "production-private"],
    "identityPoolRefs": [],
    "maximumEffect": "platform-write"
  },
  "budgets": {
    "maxRunsPerDay": 4,
    "maxCostPerDay": 0,
    "currency": "CNY"
  }
}
