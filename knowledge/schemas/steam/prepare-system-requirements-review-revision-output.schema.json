{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/steam/prepare-system-requirements-review-revision-output.schema.json",
  "title": "SteamSystemRequirementsReviewRevision",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "gameRef", "sourceRevisionRef", "buildRevisionRef", "policyRevision", "manualReview", "savedToSteamworks", "previewedOnSteam", "published", "markedReadyForReview", "released", "executionAuthorized", "preparedAt", "status", "revisionHash", "platforms", "preflight"],
  "properties": {
    "schemaVersion": { "const": "dsh.steam-system-requirements-review-revision/v1" },
    "gameRef": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,191}$" },
    "sourceRevisionRef": { "$ref": "#/$defs/ref" },
    "buildRevisionRef": { "$ref": "#/$defs/ref" },
    "policyRevision": { "const": "steam-system-requirements-2026-08-27" },
    "status": { "enum": ["ready-for-human-review", "blocked"] },
    "revisionHash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "platforms": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/platform" } },
    "manualReview": {
      "type": "object", "additionalProperties": false, "required": ["required", "checks"],
      "properties": {
        "required": { "const": true },
        "checks": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "items": { "type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": {
            "id": { "enum": ["minimum-is-lowest-supported-configuration", "recommended-performance-target-is-defined", "build-launches-on-each-listed-platform", "store-os-build-depot-package-consistency", "hardware-claims-match-test-evidence", "os-version-claims-are-current", "additional-notes-are-clear-and-non-misleading"] },
            "status": { "const": "pending" }
          } }
        }
      }
    },
    "preflight": {
      "type": "object", "additionalProperties": false, "required": ["checks", "blockers"],
      "properties": {
        "checks": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": {
          "id": { "enum": ["unique-supported-platforms", "minimum-core-field-completeness", "optional-recommended-tier-completeness", "platform-field-compatibility", "build-depot-package-test-evidence-present"] },
          "status": { "enum": ["passed", "failed"] }
        } } },
        "blockers": { "type": "array", "maxItems": 20, "items": { "type": "object", "additionalProperties": false, "required": ["code", "platform"], "properties": {
          "code": { "enum": ["minimum-core-fields-missing", "recommended-core-fields-missing", "directx-only-valid-for-windows"] },
          "platform": { "enum": ["windows", "macos", "linux-steamos"] },
          "fields": { "type": "array", "uniqueItems": true, "items": { "enum": ["os", "processor", "memory", "graphics", "storage"] } }
        } } }
      }
    },
    "savedToSteamworks": { "const": false }, "previewedOnSteam": { "const": false }, "published": { "const": false },
    "markedReadyForReview": { "const": false }, "released": { "const": false }, "executionAuthorized": { "const": false },
    "preparedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "ready-for-human-review" } } },
    "then": { "properties": { "revisionHash": { "$ref": "#/$defs/digest" }, "platforms": { "minItems": 1 }, "preflight": { "properties": { "blockers": { "maxItems": 0 } } } } },
    "else": { "properties": { "revisionHash": { "type": "null" }, "platforms": { "maxItems": 0 }, "preflight": { "properties": { "blockers": { "minItems": 1 } } } } }
  }],
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "refs10": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "refs20": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "requirement": { "type": "object", "additionalProperties": false, "required": ["field", "value", "evidenceRefs", "valueDigest"], "properties": {
      "field": { "enum": ["os", "processor", "memory", "graphics", "directx", "network", "storage", "sound-card", "additional-notes"] },
      "value": { "type": "string", "minLength": 1, "maxLength": 500 }, "evidenceRefs": { "$ref": "#/$defs/refs10" }, "valueDigest": { "$ref": "#/$defs/digest" }
    } },
    "platform": { "type": "object", "additionalProperties": false, "required": ["platform", "buildArtifactRef", "depotRefs", "publicPackageRefs", "launchTestRefs", "minimum", "recommended"], "properties": {
      "platform": { "enum": ["windows", "macos", "linux-steamos"] }, "buildArtifactRef": { "$ref": "#/$defs/ref" },
      "depotRefs": { "$ref": "#/$defs/refs10" }, "publicPackageRefs": { "$ref": "#/$defs/refs10" }, "launchTestRefs": { "$ref": "#/$defs/refs20" },
      "minimum": { "type": "array", "minItems": 5, "maxItems": 9, "items": { "$ref": "#/$defs/requirement" } },
      "recommended": { "type": "array", "maxItems": 9, "items": { "$ref": "#/$defs/requirement" } }
    } }
  }
}
