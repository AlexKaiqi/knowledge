{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/schemas/assistant/observe-multi-turn-response-repetition-input.schema.json",
  "title": "ObserveMultiTurnResponseRepetitionInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["suiteRef", "cases"],
  "properties": {
    "suiteRef": { "$ref": "#/$defs/opaqueRef" },
    "cases": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "opaqueRef": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n\\u0000]+$" },
    "response": {
      "type": "object", "additionalProperties": false, "required": ["responseRef", "text"],
      "properties": { "responseRef": { "$ref": "#/$defs/id" }, "text": { "type": "string", "minLength": 1, "maxLength": 4000 } }
    },
    "repeatContext": {
      "type": "object", "additionalProperties": false, "required": ["currentResponseRef", "priorResponseRef", "kind", "evidenceRefs"],
      "properties": {
        "currentResponseRef": { "$ref": "#/$defs/id" }, "priorResponseRef": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["requested-repeat", "confirmation-readback", "repair-or-correction", "safety-boundary", "persona-catchphrase", "other-reviewed-context"] },
        "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/opaqueRef" } }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false, "required": ["caseRef", "locale", "responses", "repeatContexts"],
      "properties": {
        "caseRef": { "$ref": "#/$defs/id" }, "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
        "responses": { "type": "array", "minItems": 2, "maxItems": 20, "items": { "$ref": "#/$defs/response" } },
        "repeatContexts": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/repeatContext" } }
      }
    }
  }
}
