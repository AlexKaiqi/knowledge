{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/steam/prepare-content-survey-review-revision-output.schema.json",
  "title": "SteamContentSurveyReviewRevision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gameRef", "sourceRevisionRef", "buildRevisionRef", "questionnaireRevisionRef", "policyRevision", "manualReview", "platformValidated", "buildValidatedByConnector", "submittedToSteamworks", "ratingIssued", "storefrontVisibilityChanged", "markedReadyForReview", "released", "executionAuthorized", "preparedAt", "status", "revisionHash", "sections", "declarations", "aiDisclosure", "preflight"],
  "properties": {
    "schemaVersion": { "const": "dsh.steam-content-survey-review-revision/v1" },
    "gameRef": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,191}$" },
    "sourceRevisionRef": { "$ref": "#/$defs/ref" },
    "buildRevisionRef": { "$ref": "#/$defs/ref" },
    "questionnaireRevisionRef": { "$ref": "#/$defs/ref" },
    "policyRevision": { "const": "steam-content-survey-2026-08-27" },
    "status": { "enum": ["ready-for-human-review", "blocked"] },
    "revisionHash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "sections": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["section", "expectedQuestionRefs", "answers"],
        "properties": {
          "section": { "$ref": "#/$defs/section" },
          "expectedQuestionRefs": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
          "answers": {
            "type": "array", "minItems": 1, "maxItems": 100,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["questionRef", "response", "evidenceRefs", "contentRefs"],
              "properties": {
                "questionRef": { "$ref": "#/$defs/ref" },
                "response": { "$ref": "#/$defs/response" },
                "evidenceRefs": { "$ref": "#/$defs/refs" },
                "contentRefs": { "$ref": "#/$defs/refs" }
              }
            }
          }
        }
      }
    },
    "declarations": {
      "type": "object", "additionalProperties": false,
      "required": ["allUploadedAdultContentDisclosed", "answersMatchCurrentBuildAndStorePage"],
      "properties": {
        "allUploadedAdultContentDisclosed": { "type": "boolean" },
        "answersMatchCurrentBuildAndStorePage": { "type": "boolean" }
      }
    },
    "aiDisclosure": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "shippedContentRefs", "runtimeContentRefs", "rightsEvidenceRefs", "guardrailEvidenceRefs"],
      "properties": {
        "mode": { "enum": ["none", "pre-generated", "live-generated", "both"] },
        "shippedContentRefs": { "$ref": "#/$defs/optionalRefs" },
        "runtimeContentRefs": { "$ref": "#/$defs/optionalRefs" },
        "rightsEvidenceRefs": { "$ref": "#/$defs/optionalRefs" },
        "guardrailEvidenceRefs": { "$ref": "#/$defs/optionalRefs" }
      }
    },
    "manualReview": {
      "type": "object", "additionalProperties": false, "required": ["required", "checks"],
      "properties": {
        "required": { "const": true },
        "checks": {
          "type": "array", "minItems": 8, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "status"],
            "properties": {
              "id": { "enum": ["current-questionnaire-revision", "question-mapping-and-answer-truthfulness", "current-build-and-store-page-match", "mature-content-disclosure-complete", "generative-ai-classification-complete", "ai-rights-and-legality-evidence", "live-ai-guardrails-sufficient", "owned-target-and-submitter-authority"] },
              "status": { "const": "pending" }
            }
          }
        }
      }
    },
    "preflight": {
      "type": "object", "additionalProperties": false, "required": ["checks", "blockers"],
      "properties": {
        "checks": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "status"],
            "properties": {
              "id": { "enum": ["three-required-sections", "question-answer-set-closed", "adult-content-disclosure-declared", "build-and-store-consistency-declared", "generative-ai-evidence-shape", "answer-evidence-and-content-bound"] },
              "status": { "enum": ["passed", "failed"] }
            }
          }
        },
        "blockers": {
          "type": "array", "maxItems": 310,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["code"],
            "properties": {
              "code": { "enum": ["missing-question-answer", "unexpected-question-answer", "duplicate-question-answer", "missing-required-section", "duplicate-section", "adult-content-disclosure-unconfirmed", "build-and-store-consistency-unconfirmed", "ai-evidence-incomplete", "ai-mode-evidence-conflict"] },
              "section": { "$ref": "#/$defs/section" },
              "questionRef": { "$ref": "#/$defs/ref" },
              "detail": { "enum": ["shipped-content", "rights-evidence", "runtime-content", "guardrail-evidence", "unexpected-shipped-content", "unexpected-live-content-or-guardrails", "unexpected-ai-rights-evidence"] }
            }
          }
        }
      }
    },
    "platformValidated": { "const": false },
    "buildValidatedByConnector": { "const": false },
    "submittedToSteamworks": { "const": false },
    "ratingIssued": { "const": false },
    "storefrontVisibilityChanged": { "const": false },
    "markedReadyForReview": { "const": false },
    "released": { "const": false },
    "executionAuthorized": { "const": false },
    "preparedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ready-for-human-review" } } },
      "then": {
        "properties": {
          "revisionHash": { "$ref": "#/$defs/digest" },
          "sections": { "minItems": 3, "maxItems": 3 },
          "preflight": { "properties": { "blockers": { "maxItems": 0 } } }
        }
      },
      "else": {
        "properties": {
          "revisionHash": { "type": "null" },
          "sections": { "maxItems": 0 },
          "preflight": { "properties": { "blockers": { "minItems": 1 } } }
        }
      }
    }
  ],
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n\\u0000]+$" },
    "refs": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "optionalRefs": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "section": { "enum": ["general-content", "mature-content", "generative-ai-content"] },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "response": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "boolean" }, "value": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "single-choice" }, "value": { "$ref": "#/$defs/ref" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "multi-choice" }, "value": { "type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "text" }, "value": { "type": "string", "minLength": 1, "maxLength": 2000 } } }
      ]
    }
  }
}
