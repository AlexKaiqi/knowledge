{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/schemas/steam/prepare-store-asset-review-revision-output.schema.json",
  "title": "Steam store asset review revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "revisionHash", "gameRef", "sourceRevisionRef", "rightsBasisRefs", "assets", "summary", "preflight", "manualReview", "uploaded", "markedReadyForReview", "released", "executionAuthorized", "preparedAt"],
  "properties": {
    "schemaVersion": { "const": "dsh.steam-store-asset-review-revision/v1" },
    "status": { "enum": ["ready-for-human-review", "blocked"] },
    "revisionHash": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "gameRef": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,191}$" },
    "sourceRevisionRef": { "$ref": "#/$defs/opaqueRef" },
    "rightsBasisRefs": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/opaqueRef" } },
    "assets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "format", "width", "height", "sizeBytes", "sha256"],
        "properties": {
          "kind": { "enum": ["header-capsule", "small-capsule", "main-capsule", "vertical-capsule", "screenshot"] },
          "path": { "$ref": "#/$defs/relativePath" },
          "format": { "enum": ["png", "jpeg"] },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetCount", "screenshotCount", "totalBytes"],
      "properties": {
        "assetCount": { "type": "integer", "minimum": 0 },
        "screenshotCount": { "type": "integer", "minimum": 0 },
        "totalBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "blockers"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": { "enum": ["required-capsule-set", "minimum-screenshot-count", "screenshot-byte-uniqueness", "image-header-and-dimensions", "workspace-boundary", "asset-budgets"] },
              "status": { "enum": ["passed", "failed"] }
            }
          }
        },
        "blockers": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["code"],
            "additionalProperties": false,
            "properties": {
              "code": { "enum": ["required-capsule-count", "minimum-screenshot-count", "duplicate-screenshot-content", "asset-count-budget-exceeded", "source-directory-unavailable", "source-directory-symlink", "source-directory-not-directory", "source-directory-outside-workspace", "asset-missing", "symlink-not-allowed", "regular-file-required", "asset-outside-source", "secret-like-filename", "single-asset-budget-exceeded", "invalid-image-header", "capsule-dimensions-mismatch", "screenshot-dimensions-mismatch", "asset-mutated-during-read", "total-asset-budget-exceeded"] },
              "path": { "$ref": "#/$defs/relativePath" },
              "duplicateOf": { "$ref": "#/$defs/relativePath" },
              "kind": { "enum": ["header-capsule", "small-capsule", "main-capsule", "vertical-capsule", "screenshot"] },
              "expected": {},
              "observed": {},
              "expectedMinimum": { "type": "integer", "minimum": 0 },
              "maximum": { "type": "integer", "minimum": 0 },
              "maximumBytes": { "type": "integer", "minimum": 0 },
              "observedBytes": { "type": "integer", "minimum": 0 },
              "detail": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          }
        }
      }
    },
    "manualReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "checks"],
      "properties": {
        "required": { "const": true },
        "checks": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": { "enum": ["capsule-readable-product-name", "capsule-base-content-only", "capsule-pg13-artwork", "screenshots-gameplay-only", "screenshots-age-suitability-marking", "rights-and-launch-content"] },
              "status": { "const": "pending" }
            }
          }
        }
      }
    },
    "uploaded": { "const": false },
    "markedReadyForReview": { "const": false },
    "released": { "const": false },
    "executionAuthorized": { "const": false },
    "preparedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ready-for-human-review" } }, "required": ["status"] },
      "then": {
        "properties": {
          "revisionHash": { "$ref": "#/$defs/digest" },
          "assets": { "minItems": 9 },
          "preflight": { "properties": { "blockers": { "maxItems": 0 } } }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
      "then": {
        "properties": {
          "revisionHash": { "type": "null" },
          "assets": { "maxItems": 0 },
          "preflight": { "properties": { "blockers": { "minItems": 1 } } }
        }
      }
    }
  ],
  "$defs": {
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$" },
    "opaqueRef": { "type": "string", "minLength": 1, "maxLength": 500 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
