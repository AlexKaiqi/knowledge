{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "google-places-public-reviews-maintainer",
  "version": "0.1.0",
  "scope": {
    "knowledgeGlobs": [
      "docs/research/demand-signal-access-routes.md",
      "knowledge/capabilities/research/read-public-place-review-snapshot.md",
      "knowledge/concepts/research/public-place-review-snapshot.md",
      "knowledge/schemas/research/read-public-place-review-snapshot-*.schema.json",
      "knowledge/verifications/research/public-place-review-snapshot/*.json"
    ],
    "connectorIds": ["google-places-public-reviews"],
    "capabilityRefs": ["/capabilities/research/read-public-place-review-snapshot.md"]
  },
  "triggers": [
    { "kind": "schedule", "schedule": "35 9 * * 2,5" },
    { "kind": "source-change" },
    { "kind": "schema-change" },
    { "kind": "connector-change" },
    { "kind": "failed-execution" },
    { "kind": "manual" }
  ],
  "execution": {
    "kind": "deterministic",
    "runtime": "node >=22.19",
    "entrypoint": "collectors/google-places-public-reviews-maintainer/src/index.mjs"
  },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": {
    "mode": "proposal-only",
    "requiresApprovalFor": ["knowledge", "connector", "identity", "credential", "live-probe"]
  },
  "probePolicy": {
    "allowedEnvironments": ["production-public"],
    "identityPoolRefs": ["identity-pool:google-maps-platform-probes"],
    "maximumEffect": "financial"
  },
  "budgets": { "maxRunsPerDay": 2, "maxCostPerDay": 0, "currency": "USD" }
}
