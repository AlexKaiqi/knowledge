{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "xiaohongshu-maintainer",
  "version": "0.9.0",
  "projectCatalogRef": "repo:/collectors/xiaohongshu-maintainer/projects.json",
  "scope": {
    "knowledgeGlobs": [
      "knowledge/platforms/xiaohongshu.md",
      "knowledge/concepts/xiaohongshu/*.md",
      "knowledge/capabilities/xiaohongshu/*.md",
      "knowledge/verifications/xiaohongshu/**/*.json"
    ],
    "connectorIds": ["xiaohongshu-browser", "github-public-repository-search", "github-public-repository-tags"],
    "capabilityRefs": [
      "/capabilities/xiaohongshu/publish-private-note-and-observe.md",
      "/capabilities/xiaohongshu/list-owned-notes.md",
      "/capabilities/github/search-public-repositories.md",
      "/capabilities/github/list-public-repository-tags.md"
    ]
  },
  "triggers": [
    { "kind": "schedule", "schedule": "0 6 * * *" },
    { "kind": "source-change" },
    { "kind": "connector-change" },
    { "kind": "failed-execution" },
    { "kind": "manual" }
  ],
  "execution": {
    "kind": "deterministic",
    "runtime": "node >=22.19",
    "entrypoint": "collectors/xiaohongshu-maintainer/src/index.mjs"
  },
  "outputs": [
    "knowledge-proposal",
    "connector-change-proposal",
    "verification-report"
  ],
  "writePolicy": {
    "mode": "proposal-only",
    "requiresApprovalFor": [
      "knowledge",
      "connector",
      "identity",
      "credential",
      "live-probe"
    ]
  },
  "probePolicy": {
    "allowedEnvironments": ["local", "production-public", "production-private"],
    "identityPoolRefs": ["identity-pool:xiaohongshu-owned-probes"],
    "maximumEffect": "platform-write"
  },
  "budgets": {
    "maxRunsPerDay": 4,
    "maxCostPerDay": 0,
    "currency": "CNY"
  }
}
