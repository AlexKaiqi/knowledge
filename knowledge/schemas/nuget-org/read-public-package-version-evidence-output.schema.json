{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/nuget-org/read-public-package-version-evidence-output.schema.json",
  "title": "ReadNuGetOrgPublicPackageVersionEvidenceOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "request", "packageVersion", "access", "observedAt", "resultDigest", "conformance"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "serviceIndexUrl", "registrationResourceType", "packageContentResourceType"],
      "properties": {
        "id": { "const": "nuget-org-public-package-version" },
        "serviceIndexUrl": { "const": "https://api.nuget.org/v3/index.json" },
        "registrationResourceType": { "const": "RegistrationsBaseUrl/3.6.0" },
        "packageContentResourceType": { "const": "PackageBaseAddress/3.0.0" }
      }
    },
    "request": { "$ref": "#/$defs/request" },
    "packageVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "listed", "publishedAt", "prerelease", "minClientVersion", "license", "projectUrl", "deprecation", "vulnerabilities", "artifact"],
      "properties": {
        "id": { "$ref": "#/$defs/packageId" },
        "version": { "$ref": "#/$defs/version" },
        "listed": { "type": "boolean" },
        "publishedAt": { "type": ["string", "null"], "format": "date-time" },
        "prerelease": { "type": "boolean" },
        "minClientVersion": { "type": ["string", "null"], "maxLength": 64 },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expression", "url", "requiresAcceptance"],
          "properties": {
            "expression": { "type": ["string", "null"], "maxLength": 256 },
            "url": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
            "requiresAcceptance": { "type": "boolean" }
          }
        },
        "projectUrl": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
        "deprecation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deprecated", "reasons", "alternatePackage"],
          "properties": {
            "deprecated": { "type": "boolean" },
            "reasons": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "enum": ["legacy", "criticalbugs", "other"] } },
            "alternatePackage": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "range"],
                  "properties": {
                    "id": { "$ref": "#/$defs/packageId" },
                    "range": { "type": ["string", "null"], "maxLength": 256 }
                  }
                }
              ]
            }
          }
        },
        "vulnerabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "bySeverity"],
          "properties": {
            "total": { "type": "integer", "minimum": 0, "maximum": 256 },
            "bySeverity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["low", "moderate", "high", "critical"],
              "properties": {
                "low": { "type": "integer", "minimum": 0, "maximum": 256 },
                "moderate": { "type": "integer", "minimum": 0, "maximum": 256 },
                "high": { "type": "integer", "minimum": 0, "maximum": 256 },
                "critical": { "type": "integer", "minimum": 0, "maximum": 256 }
              }
            }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileName", "contentUrl", "sizeBytes", "sha256", "sha512", "serverSha512Matched", "entryCount", "declaredUncompressedBytes", "centralDirectorySha256", "manifestEntry", "signatureEntry", "signaturePresent", "signatureCryptographicallyVerified"],
          "properties": {
            "fileName": { "type": "string", "minLength": 7, "maxLength": 180, "pattern": "^[a-z0-9_.-]+\\.nupkg$" },
            "contentUrl": { "type": "string", "format": "uri", "pattern": "^https://api\\.nuget\\.org/v3-flatcontainer/" },
            "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "sha512": { "$ref": "#/$defs/sha512" },
            "serverSha512Matched": { "type": ["boolean", "null"] },
            "entryCount": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "declaredUncompressedBytes": { "type": "integer", "minimum": 1 },
            "centralDirectorySha256": { "$ref": "#/$defs/sha256" },
            "manifestEntry": { "$ref": "#/$defs/archiveEntry" },
            "signatureEntry": { "$ref": "#/$defs/archiveEntry" },
            "signaturePresent": { "const": true },
            "signatureCryptographicallyVerified": { "const": false }
          }
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authentication", "logicalGetCount", "transportGetCount", "redirectCount", "transportOrigins", "packageDownloaded", "packageInstalled", "packageExecuted", "dependenciesResolved"],
      "properties": {
        "authentication": { "const": "none" },
        "logicalGetCount": { "type": "integer", "minimum": 3, "maximum": 4 },
        "transportGetCount": { "type": "integer", "minimum": 3, "maximum": 8 },
        "redirectCount": { "type": "integer", "minimum": 0, "maximum": 4 },
        "transportOrigins": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["https://api.nuget.org", "https://nuget.azure.cn"] } },
        "packageDownloaded": { "const": true },
        "packageInstalled": { "const": false },
        "packageExecuted": { "const": false },
        "dependenciesResolved": { "const": false }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "resultDigest": { "$ref": "#/$defs/sha256" },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assertions"],
      "properties": {
        "status": { "enum": ["passed", "review-required"] },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "passed": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "packageId": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^(?!.*(?:\\.\\.|--))[A-Za-z0-9_](?:[A-Za-z0-9_.-]{0,98}[A-Za-z0-9_])?$" },
    "version": { "type": "string", "minLength": 5, "maxLength": 64, "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:\\.(?:[1-9][0-9]*))?(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha512": { "type": "string", "pattern": "^[a-f0-9]{128}$" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "version"],
      "properties": {
        "packageId": { "$ref": "#/$defs/packageId" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "archiveEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sizeBytes"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    }
  }
}
