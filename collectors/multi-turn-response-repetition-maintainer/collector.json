{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "multi-turn-response-repetition-maintainer",
  "version": "1.0.0",
  "scope": {
    "knowledgeGlobs": [
      "knowledge/tools/multi-turn-response-repetition-observer.md",
      "knowledge/concepts/assistant/multi-turn-response-repetition-observation-suite.md",
      "knowledge/capabilities/assistant/observe-multi-turn-response-repetition.md",
      "knowledge/schemas/assistant/observe-multi-turn-response-repetition-*.schema.json",
      "knowledge/verifications/assistant/multi-turn-response-repetition/*.json"
    ],
    "connectorIds": ["multi-turn-response-repetition-observer"],
    "capabilityRefs": ["/capabilities/assistant/observe-multi-turn-response-repetition.md"]
  },
  "triggers": [{ "kind": "schedule", "schedule": "15 10 * * 2" }, { "kind": "source-change" }, { "kind": "schema-change" }, { "kind": "connector-change" }, { "kind": "failed-execution" }, { "kind": "manual" }],
  "execution": { "kind": "deterministic", "runtime": "node >=22.19", "entrypoint": "collectors/multi-turn-response-repetition-maintainer/src/index.mjs" },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": { "mode": "proposal-only", "requiresApprovalFor": ["knowledge", "connector", "live-probe"] },
  "probePolicy": { "allowedEnvironments": ["local", "production-public"], "identityPoolRefs": [], "maximumEffect": "none" },
  "budgets": { "maxRunsPerDay": 2, "maxCostPerDay": 0, "currency": "CNY" }
}
