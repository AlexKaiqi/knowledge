{
  "name": "knowledge-catalog-tooling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private validation tooling for a Git-backed OKF knowledge catalog.",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "knowledge:check": "node scripts/check-okf-knowledge.mjs",
    "test": "node --test test/*.test.mjs connectors/*/test/*.test.mjs collectors/*/test/*.test.mjs",
    "check": "node --check scripts/*.mjs connectors/*/src/*.mjs collectors/lib/*.mjs collectors/*/src/*.mjs && npm run knowledge:check && npm test",
    "xhs:bootstrap": "node scripts/bootstrap-xiaohongshu.mjs",
    "xhs:login": "node scripts/run-xiaohongshu.mjs login",
    "xhs:serve": "node scripts/run-xiaohongshu.mjs serve",
    "xhs:doctor": "node scripts/doctor-xiaohongshu.mjs",
    "xhs:skill:bootstrap": "node scripts/bootstrap-xiaohongshu-skill.mjs",
    "xhs:skill:login": "node scripts/login-xiaohongshu-skill.mjs",
    "xhs:skill:doctor": "node scripts/doctor-xiaohongshu-skill.mjs",
    "xhs:probe:prepare": "node scripts/prepare-xiaohongshu-probe.mjs",
    "xhs:probe:confirm": "node scripts/confirm-xiaohongshu-probe.mjs",
    "xhs:probe:run": "node scripts/probe-xiaohongshu.mjs",
    "xhs:skill:probe:run": "node scripts/probe-xiaohongshu.mjs --route=creator-web-xiaohongshu-skill",
    "xhs:maintain": "node collectors/xiaohongshu-maintainer/src/index.mjs",
    "xhs:account-api:probe": "node scripts/probe-xiaohongshu-account-docs.mjs",
    "xhs:account-api:maintain": "node collectors/xiaohongshu-account-docs-maintainer/src/index.mjs",
    "xhs:owned-notes:probe": "node scripts/probe-xiaohongshu-owned-notes.mjs",
    "xhs:community-rules:probe": "node scripts/probe-xiaohongshu-community-rules.mjs",
    "xhs:community-rules:maintain": "node collectors/xiaohongshu-community-rules-maintainer/src/index.mjs",
    "douyin:open-platform:probe": "node scripts/probe-douyin-open-platform-docs.mjs",
    "douyin:open-platform:maintain": "node collectors/douyin-open-platform-docs-maintainer/src/index.mjs",
    "douyin:public-video-embed:probe": "node scripts/probe-douyin-public-video-embed.mjs",
    "douyin:public-video-embed:maintain": "node collectors/douyin-public-video-embed-maintainer/src/index.mjs",
    "douyin:maintain": "node collectors/douyin-maintainer/src/index.mjs",
    "hugging-face:model-revision:probe": "node scripts/probe-hugging-face-public-model-revision.mjs",
    "hugging-face:model-revision:maintain": "node collectors/hugging-face-public-model-revision-maintainer/src/index.mjs",
    "github:repositories:probe": "node scripts/probe-github-public-repository-search.mjs",
    "github:repositories:maintain": "node collectors/github-public-repository-search-maintainer/src/index.mjs",
    "github:file:probe": "node scripts/probe-github-public-repository-file.mjs",
    "github:file:maintain": "node collectors/github-public-repository-file-maintainer/src/index.mjs",
    "github:tags:probe": "node scripts/probe-github-public-repository-tags.mjs",
    "github:tags:maintain": "node collectors/github-public-repository-tags-maintainer/src/index.mjs",
    "github:release:probe": "node scripts/probe-github-public-repository-release.mjs",
    "github:release:maintain": "node collectors/github-public-repository-release-maintainer/src/index.mjs",
    "github:work-items:probe": "node scripts/probe-github-public-repository-work-item-changes.mjs",
    "github:work-items:maintain": "node collectors/github-public-repository-work-item-changes-maintainer/src/index.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0"
  }
}
