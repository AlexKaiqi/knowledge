{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/github/read-public-repository-file-input.schema.json",
  "title": "ReadGitHubPublicRepositoryFileInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "path", "revision"],
  "properties": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,38})/[A-Za-z0-9_.-]{1,100}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\r\\n]).+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  }
}
