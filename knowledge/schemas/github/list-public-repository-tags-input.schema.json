{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/github/list-public-repository-tags-input.schema.json",
  "title": "ListGitHubPublicRepositoryTagsInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["owner", "repository"],
  "properties": {
    "owner": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,98}[A-Za-z0-9])?$" },
    "repository": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^(?!\\.{1,2}$)(?!.*\\.[gG][iI][tT]$)[A-Za-z0-9._-]+$" },
    "maxTags": { "type": "integer", "minimum": 1, "maximum": 500, "default": 200 }
  }
}
