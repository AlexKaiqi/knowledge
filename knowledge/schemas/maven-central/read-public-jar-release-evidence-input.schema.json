{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/maven-central/read-public-jar-release-evidence-input.schema.json",
  "title": "ReadMavenCentralPublicJarReleaseEvidenceInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["groupId", "artifactId", "version"],
  "properties": {
    "groupId": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9_]+(?:[.-][A-Za-z0-9_]+)*$" },
    "artifactId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_.+-]*[A-Za-z0-9_])?$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!(?:[Ll][Aa][Tt][Ee][Ss][Tt]|[Rr][Ee][Ll][Ee][Aa][Ss][Ee])$)(?!.*(?:^|[-.])[Ss][Nn][Aa][Pp][Ss][Hh][Oo][Tt]$)[A-Za-z0-9](?:[A-Za-z0-9._+-]*[A-Za-z0-9])?$" }
  }
}
