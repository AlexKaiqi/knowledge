{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/connector-definition.schema.json",
  "title": "ConnectorDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "capabilityRefs", "implementation", "execution", "configSchema", "credentialSlots", "handlers", "conformance"],
  "properties": {
    "schemaVersion": { "const": "dsh.connector-definition/v1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "minLength": 1 },
    "capabilityRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/localRef" } },
    "implementation": { "$ref": "#/$defs/implementation" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runtime"],
      "properties": {
        "kind": { "enum": ["deterministic", "agentic", "hybrid", "manual"] },
        "runtime": { "type": "string", "minLength": 1 },
        "modelRouteRef": { "type": "string", "minLength": 1 },
        "promptRef": { "type": "string", "minLength": 1 },
        "toolRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evalRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["agentic", "hybrid"] } }, "required": ["kind"] },
          "then": { "required": ["modelRouteRef", "promptRef", "evalRefs"] }
        }
      ]
    },
    "configSchema": { "type": "string", "minLength": 1 },
    "credentialSlots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required"],
        "properties": {
          "name": { "$ref": "#/$defs/id" },
          "required": { "type": "boolean" },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "handlers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityRef", "operation"],
        "properties": {
          "capabilityRef": { "$ref": "#/$defs/localRef" },
          "operation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probeReportRef"],
      "properties": { "probeReportRef": { "$ref": "#/$defs/localRef" } }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "localRef": { "type": "string", "pattern": "^/(?!/)(?!.*\\.\\.)[^?#]+$" },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "revision", "entrypoint", "contentSha256"],
      "properties": {
        "project": { "$ref": "#/$defs/id" },
        "repository": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
        "entrypoint": { "type": "string", "minLength": 1 },
        "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
