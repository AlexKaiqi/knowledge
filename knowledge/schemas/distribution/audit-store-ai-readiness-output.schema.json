{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/schemas/distribution/audit-store-ai-readiness-output.schema.json",
  "title": "Point-in-time public store AI readiness audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "domain", "readiness", "categories", "findings", "crawlerAccess", "measurement", "observedAt", "resultDigest", "conformance"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "upstreamSchemaVersion"],
      "properties": {
        "tool": { "const": "optifeed-radar" },
        "version": { "const": "0.3.0" },
        "upstreamSchemaVersion": { "const": "0.3" }
      }
    },
    "domain": {
      "type": "string",
      "minLength": 3,
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "minimum", "maximum", "scoreKind"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "minimum": { "const": 0 },
        "maximum": { "const": 100 },
        "scoreKind": { "const": "site-ai-readiness" }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "weight", "earned"],
        "properties": {
          "id": { "enum": ["robots", "structured", "llms", "meta", "sitemap"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "weight": { "type": "number", "minimum": 0, "maximum": 100 },
          "earned": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "message"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "severity": { "enum": ["info", "warn", "error"] },
          "message": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "crawlerAccess": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bot", "vendor", "access", "via"],
        "properties": {
          "bot": { "type": "string", "minLength": 1, "maxLength": 100 },
          "vendor": { "type": "string", "minLength": 1, "maxLength": 100 },
          "access": { "enum": ["allowed", "blocked"] },
          "via": { "enum": ["specific", "wildcard", "default"] }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "aiEngineCalls", "apiCost", "currency", "recommendationVisibilityMeasured", "sampledSitemapPagesMaximum", "conclusionsRequireHumanReview"],
      "properties": {
        "kind": { "const": "point-in-time-public-site-readiness" },
        "aiEngineCalls": { "const": false },
        "apiCost": { "const": 0 },
        "currency": { "const": "USD" },
        "recommendationVisibilityMeasured": { "const": false },
        "sampledSitemapPagesMaximum": { "const": 3 },
        "conclusionsRequireHumanReview": { "const": true }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "resultDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assertions"],
      "properties": {
        "status": { "enum": ["passed", "review-required"] },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "passed": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
