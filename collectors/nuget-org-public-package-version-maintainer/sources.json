{
  "schemaVersion": "dsh.source-watch-list/v1",
  "subject": "nuget-org",
  "sources": [
    {
      "id": "nuget-server-api-overview",
      "url": "https://learn.microsoft.com/en-us/nuget/api/overview",
      "role": "redirect-authentication-and-retry-contract",
      "observation": {
        "mode": "static-html-semantic",
        "assertions": [
          { "id": "get-redirects-supported", "includes": "Any GET request made to a API endpoint may return an HTTP redirect" },
          { "id": "public-read-no-auth", "includes": "only the PackagePublish resource requires authentication" }
        ]
      }
    },
    {
      "id": "nuget-registration-resource",
      "url": "https://learn.microsoft.com/en-us/nuget/api/registration-base-url-resource",
      "role": "package-metadata-and-pagination-contract",
      "observation": {
        "mode": "static-html-semantic",
        "assertions": [
          { "id": "semver2-hive", "includes": "RegistrationsBaseUrl/3.6.0" },
          { "id": "service-index-discovery", "includes": "must be dynamically fetched from the service index" },
          { "id": "leaf-content-url", "includes": "packageContent" }
        ]
      }
    },
    {
      "id": "nuget-package-content-resource",
      "url": "https://learn.microsoft.com/en-us/nuget/api/package-base-address-resource",
      "role": "nupkg-path-and-version-normalization-contract",
      "observation": {
        "mode": "static-html-semantic",
        "assertions": [
          { "id": "flat-container", "includes": "flat container" },
          { "id": "normalized-lower-version", "includes": "normalized and lowercased" },
          { "id": "package-content-response", "includes": "response body will be the package content itself" }
        ]
      }
    },
    {
      "id": "nuget-deletion-and-signing-policy",
      "url": "https://learn.microsoft.com/en-us/nuget/nuget-org/policies/deleting-packages",
      "role": "unlisting-and-exceptional-deletion-policy",
      "observation": {
        "mode": "static-html-semantic",
        "assertions": [
          { "id": "no-normal-permanent-delete", "includes": "does not support permanent deletion of packages" },
          { "id": "exact-unlisted-restore", "includes": "can still be downloaded and installed by using an exact version number" },
          { "id": "exceptional-deletion", "includes": "packages can be deleted manually by the NuGet team" }
        ]
      }
    },
    {
      "id": "nuget-signed-packages",
      "url": "https://learn.microsoft.com/en-us/nuget/reference/signed-packages-reference",
      "role": "repository-signature-semantics",
      "observation": {
        "mode": "static-html-semantic",
        "assertions": [
          { "id": "repository-signature-meaning", "includes": "Repository signatures provide an integrity guarantee" },
          { "id": "automatic-repository-signing", "includes": "all packages uploaded to nuget.org are automatically repository signed" },
          { "id": "verification-tool-boundary", "includes": "verify packages' signatures using the dotnet nuget verify or nuget verify commands" }
        ]
      }
    }
  ]
}
