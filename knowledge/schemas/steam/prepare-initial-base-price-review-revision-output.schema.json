{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/schemas/steam/prepare-initial-base-price-review-revision-output.schema.json",
  "title": "PrepareSteamInitialBasePriceReviewRevisionOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "revisionHash", "gameRef", "sourceRevisionRef", "pricingCatalogRevisionRef", "minimumThresholdRevisionRef", "packageRef", "buildRevisionRef", "policyRevision", "observedPricingState", "target", "coverage", "manualReview", "platformStateAuthenticated", "priceValidityConfirmed", "csvGenerated", "submittedToValve", "approvedByValve", "publishedToSteam", "discountConfigured", "automaticSchedulingSupported", "executionAuthorized", "preparedAt", "preflight"],
  "properties": {
    "schemaVersion": { "const": "dsh.steam-initial-base-price-review-revision/v1" },
    "status": { "enum": ["ready-for-human-review", "blocked"] },
    "revisionHash": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }] },
    "gameRef": { "$ref": "#/$defs/safeId" },
    "sourceRevisionRef": { "$ref": "#/$defs/ref" },
    "pricingCatalogRevisionRef": { "$ref": "#/$defs/ref" },
    "minimumThresholdRevisionRef": { "$ref": "#/$defs/ref" },
    "packageRef": { "$ref": "#/$defs/ref" },
    "buildRevisionRef": { "$ref": "#/$defs/ref" },
    "policyRevision": { "const": "steam-initial-base-price-2026-08-27" },
    "observedPricingState": { "$ref": "#/$defs/observed" },
    "target": { "$ref": "#/$defs/target" },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["liveCurrencyCount", "usdRegionGroupCount", "expectedMarketCount", "suppliedMarketCount", "completeObservedMarketSet", "missingMarketCodes", "unexpectedMarketCodes", "minimumThresholdsAuthenticated", "pricingCatalogAuthenticated", "discountsIncluded", "subsequentPriceChangesIncluded"],
      "properties": {
        "liveCurrencyCount": { "const": 37 }, "usdRegionGroupCount": { "const": 4 }, "expectedMarketCount": { "const": 41 },
        "suppliedMarketCount": { "type": "integer", "minimum": 0, "maximum": 41 },
        "completeObservedMarketSet": { "type": "boolean" },
        "missingMarketCodes": { "$ref": "#/$defs/marketCodes" }, "unexpectedMarketCodes": { "$ref": "#/$defs/marketCodes" },
        "minimumThresholdsAuthenticated": { "const": false }, "pricingCatalogAuthenticated": { "const": false },
        "discountsIncluded": { "const": false }, "subsequentPriceChangesIncluded": { "const": false }
      }
    },
    "manualReview": {
      "type": "object", "additionalProperties": false, "required": ["required", "checks"],
      "properties": { "required": { "const": true }, "checks": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": { "id": { "type": "string", "minLength": 1 }, "status": { "const": "pending" } } } } }
    },
    "platformStateAuthenticated": { "const": false }, "priceValidityConfirmed": { "const": false }, "csvGenerated": { "const": false }, "submittedToValve": { "const": false }, "approvedByValve": { "const": false }, "publishedToSteam": { "const": false }, "discountConfigured": { "const": false }, "automaticSchedulingSupported": { "const": false }, "executionAuthorized": { "const": false },
    "preparedAt": { "type": "string", "format": "date-time" },
    "preflight": {
      "type": "object", "additionalProperties": false, "required": ["checks", "blockers"],
      "properties": {
        "checks": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": { "id": { "type": "string", "minLength": 1 }, "status": { "enum": ["passed", "failed"] } } } },
        "blockers": { "type": "array", "maxItems": 10, "items": { "type": "object", "additionalProperties": false, "required": ["code"], "properties": { "code": { "type": "string", "minLength": 1 }, "marketCodes": { "$ref": "#/$defs/marketCodes" } } } }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "ready-for-human-review" } } }, "then": { "properties": { "revisionHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "preflight": { "properties": { "blockers": { "maxItems": 0 } } } } } },
    { "if": { "properties": { "status": { "const": "blocked" } } }, "then": { "properties": { "revisionHash": { "type": "null" }, "preflight": { "properties": { "blockers": { "minItems": 1 } } } } } }
  ],
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,191}$" },
    "ref": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000\\r\\n]+$" },
    "refs": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "marketCodes": { "type": "array", "maxItems": 45, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{3}(?:_[A-Z]+)?$" } },
    "point": { "type": "object", "additionalProperties": false, "required": ["marketCode", "amountMinorUnits", "observedMinimumBaseMinorUnits"], "properties": { "marketCode": { "type": "string", "pattern": "^[A-Z]{3}(?:_[A-Z]+)?$" }, "amountMinorUnits": { "type": "integer", "minimum": 1, "maximum": 1000000000 }, "observedMinimumBaseMinorUnits": { "type": "integer", "minimum": 1, "maximum": 1000000000 } } },
    "observed": { "type": "object", "additionalProperties": false, "required": ["observedAt", "releaseState", "packageState", "pricingSubmissionState", "currentPriceScheduleDigest", "activeOrScheduledDiscount", "evidenceRefs"], "properties": { "observedAt": { "type": "string", "format": "date-time" }, "releaseState": { "enum": ["unreleased", "released"] }, "packageState": { "enum": ["standard-package-present", "missing"] }, "pricingSubmissionState": { "enum": ["not-submitted", "draft", "under-review", "approved"] }, "currentPriceScheduleDigest": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }] }, "activeOrScheduledDiscount": { "type": "boolean" }, "evidenceRefs": { "$ref": "#/$defs/refs" } } },
    "target": { "type": "object", "additionalProperties": false, "required": ["packageKind", "publishMode", "pricePoints", "marketResearchEvidenceRefs", "valueEvidenceRefs"], "properties": { "packageKind": { "const": "standard-base-game" }, "publishMode": { "enum": ["valve-publish-after-review", "partner-manual-publish-after-review"] }, "pricePoints": { "type": "array", "minItems": 1, "maxItems": 45, "items": { "$ref": "#/$defs/point" } }, "marketResearchEvidenceRefs": { "$ref": "#/$defs/refs" }, "valueEvidenceRefs": { "$ref": "#/$defs/refs" } } }
  }
}
