{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/crates-io/read-public-crate-version-output.schema.json",
  "title": "CratesIoPublicCrateVersionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "request", "crateVersion", "observedAt", "resultDigest", "conformance"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "apiBaseUrl", "endpointTemplate"],
      "properties": {
        "id": { "const": "crates-io-public-crate-version" },
        "apiBaseUrl": { "const": "https://crates.io" },
        "endpointTemplate": { "const": "https://crates.io/api/v1/crates/{crate}/{version}" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crateName", "version"],
      "properties": {
        "crateName": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "crateVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crateName", "version", "description", "licenseExpression", "rustVersion", "edition", "yanked", "yankedMessage", "createdAt", "updatedAt", "hasLibrary", "binaryNames", "links", "artifact"],
      "properties": {
        "crateName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": ["string", "null"], "maxLength": 2048 },
        "licenseExpression": { "type": ["string", "null"], "maxLength": 512 },
        "rustVersion": { "type": ["string", "null"], "maxLength": 64 },
        "edition": { "type": ["string", "null"], "maxLength": 16 },
        "yanked": { "type": "boolean" },
        "yankedMessage": { "type": ["string", "null"], "maxLength": 4096 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "hasLibrary": { "type": ["boolean", "null"] },
        "binaryNames": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "homepage", "documentation"],
          "properties": {
            "repository": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
            "homepage": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
            "documentation": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sizeBytes", "sha256", "downloadUrl"],
          "properties": {
            "sizeBytes": { "type": "integer", "minimum": 0 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "downloadUrl": { "type": "string", "format": "uri", "pattern": "^https://crates\\.io/api/v1/crates/[^/]+/[^/]+/download$" }
          }
        }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "resultDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assertions"],
      "properties": {
        "status": { "enum": ["passed", "review-required"] },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "passed": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
