{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/schemas/research/search-public-app-catalog-input.schema.json",
  "title": "Search public app catalog input",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "country"],
  "properties": {
    "query": { "type": "string", "minLength": 2, "maxLength": 100, "pattern": "^[^\\r\\n\\u0000*]+$" },
    "country": { "type": "string", "pattern": "^[A-Za-z]{2}$" },
    "surface": { "enum": ["iphone", "ipad", "mac"], "default": "iphone" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 25, "default": 10 }
  }
}
