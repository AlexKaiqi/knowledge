{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "web-feed-reader-maintainer",
  "version": "1.0.0",
  "scope": {
    "knowledgeGlobs": ["knowledge/tools/web-feed-reader.md", "knowledge/concepts/web-feeds/feed-snapshot.md", "knowledge/capabilities/web-feeds/read-registered-public-feed.md", "knowledge/schemas/web-feeds/*.schema.json", "knowledge/verifications/web-feeds/nodejs-releases/*.json"],
    "connectorIds": ["web-feed-reader"],
    "capabilityRefs": ["/capabilities/web-feeds/read-registered-public-feed.md"]
  },
  "triggers": [{ "kind": "schedule", "schedule": "0 8 * * *" }, { "kind": "source-change" }, { "kind": "schema-change" }, { "kind": "connector-change" }, { "kind": "failed-execution" }, { "kind": "manual" }],
  "execution": { "kind": "deterministic", "runtime": "node >=22.19", "entrypoint": "collectors/web-feed-reader-maintainer/src/index.mjs" },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": { "mode": "proposal-only", "requiresApprovalFor": ["knowledge", "connector", "live-probe"] },
  "probePolicy": { "allowedEnvironments": ["production-public"], "identityPoolRefs": [], "maximumEffect": "none" },
  "budgets": { "maxRunsPerDay": 4, "maxCostPerDay": 0, "currency": "CNY" }
}
