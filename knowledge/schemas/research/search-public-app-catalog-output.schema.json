{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/schemas/research/search-public-app-catalog-output.schema.json",
  "title": "Public app catalog search page",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "query", "coverage", "items", "observedAt", "resultDigest", "conformance"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store", "accessSurface", "contractStatus", "documentation"],
      "properties": {
        "store": { "const": "apple-app-store" },
        "accessSurface": { "const": "itunes-search-api" },
        "contractStatus": { "const": "official-documentation-archive" },
        "documentation": { "const": "https://developer.apple.com/library/archive/documentation/AudioVideo/Conceptual/iTuneSearchAPI/index.html" }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "country", "surface", "limit"],
      "properties": {
        "query": { "type": "string", "minLength": 2, "maxLength": 100 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "surface": { "enum": ["iphone", "ipad", "mac"] },
        "limit": { "type": "integer", "minimum": 1, "maximum": 25 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation", "returnedCount", "requestedLimit", "storefrontCountry", "corpusComplete", "resultSetMutable", "historical", "rankingSemantics", "resultCountSemantics", "metadataOnly"],
      "properties": {
        "representation": { "const": "bounded-search-page" },
        "returnedCount": { "type": "integer", "minimum": 0, "maximum": 25 },
        "requestedLimit": { "type": "integer", "minimum": 1, "maximum": 25 },
        "storefrontCountry": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "corpusComplete": { "const": false },
        "resultSetMutable": { "const": true },
        "historical": { "const": false },
        "rankingSemantics": { "const": "apple-search-api-unspecified" },
        "resultCountSemantics": { "const": "returned-page-size-only" },
        "metadataOnly": { "const": true }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId", "name", "bundleId", "developer", "primaryGenre", "genres", "version", "releasedAt", "currentVersionReleasedAt", "price", "rating", "storeUrl"],
        "properties": {
          "appId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 300 },
          "bundleId": { "type": "string", "minLength": 1, "maxLength": 300 },
          "developer": { "type": "string", "minLength": 1, "maxLength": 500 },
          "primaryGenre": { "type": "string", "minLength": 1, "maxLength": 100 },
          "genres": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
          "version": { "type": "string", "minLength": 1, "maxLength": 100 },
          "releasedAt": { "type": "string", "format": "date-time" },
          "currentVersionReleasedAt": { "type": "string", "format": "date-time" },
          "price": {
            "type": "object",
            "additionalProperties": false,
            "required": ["amount", "currency"],
            "properties": {
              "amount": { "type": "number", "minimum": 0, "maximum": 1000000 },
              "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
            }
          },
          "rating": {
            "type": "object",
            "additionalProperties": false,
            "required": ["average", "count"],
            "properties": {
              "average": { "type": "number", "minimum": 0, "maximum": 5 },
              "count": { "type": "integer", "minimum": 0 }
            }
          },
          "storeUrl": { "type": "string", "format": "uri", "pattern": "^https://apps\\.apple\\.com/[a-z]{2}/app/id[1-9][0-9]*$" }
        }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "resultDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assertions"],
      "properties": {
        "status": { "enum": ["passed", "review-required"] },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "passed": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
