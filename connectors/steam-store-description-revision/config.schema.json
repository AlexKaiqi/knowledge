{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/connectors/steam-store-description-revision/config.schema.json",
  "title": "SteamStoreDescriptionRevisionConnectorConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "maxLocalizations": { "type": "integer", "minimum": 1, "maximum": 31, "default": 20 },
