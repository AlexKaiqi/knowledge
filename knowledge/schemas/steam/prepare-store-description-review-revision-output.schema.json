{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/steam/prepare-store-description-review-revision-output.schema.json",
  "title": "SteamStoreDescriptionReviewRevision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gameRef", "sourceRevisionRef", "launchFeatureRefs", "rightsBasisRefs", "policyRevision", "manualReview", "uploaded", "published", "markedReadyForReview", "released", "executionAuthorized", "preparedAt", "status", "revisionHash", "localizations", "preflight"],
  "properties": {
    "schemaVersion": { "const": "dsh.steam-store-description-review-revision/v1" },
    "gameRef": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,191}$" },
    "sourceRevisionRef": { "$ref": "#/$defs/ref" },
    "launchFeatureRefs": { "$ref": "#/$defs/refs" },
    "rightsBasisRefs": { "$ref": "#/$defs/refs" },
    "policyRevision": { "const": "steam-store-description-2026-08-27" },
    "status": { "enum": ["ready-for-human-review", "blocked"] },
    "revisionHash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "localizations": {
      "type": "array",
      "maxItems": 31,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "shortDescription", "aboutThisGame", "translationBasisRef", "shortDescriptionCodePoints", "aboutThisGameCodePoints", "shortDescriptionDigest", "aboutThisGameDigest"],
        "properties": {
          "language": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
          "shortDescription": { "type": "string", "minLength": 1 },
          "aboutThisGame": { "type": "string", "minLength": 1 },
          "translationBasisRef": { "$ref": "#/$defs/ref" },
          "shortDescriptionCodePoints": { "type": "integer", "minimum": 1 },
          "aboutThisGameCodePoints": { "type": "integer", "minimum": 1 },
          "shortDescriptionDigest": { "$ref": "#/$defs/digest" },
          "aboutThisGameDigest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "manualReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "checks"],
      "properties": {
        "required": { "const": true },
        "checks": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "status": { "const": "pending" }
            }
          }
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "blockers"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "status": { "enum": ["passed", "failed"] }
            }
          }
        },
        "blockers": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": {
                "enum": ["localization-count-budget-exceeded", "english-fallback-required", "unsupported-store-language", "short-description-budget-exceeded", "about-this-game-budget-exceeded", "short-description-must-be-plain-single-line", "about-this-game-markup-not-supported", "description-link-not-allowed"]
              },
              "language": { "type": "string" },
              "maximum": { "type": "integer", "minimum": 1 },
              "observed": { "type": "integer", "minimum": 0 },
              "maximumCodePoints": { "type": "integer", "minimum": 1 },
              "observedCodePoints": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "uploaded": { "const": false },
    "published": { "const": false },
    "markedReadyForReview": { "const": false },
    "released": { "const": false },
    "executionAuthorized": { "const": false },
    "preparedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ready-for-human-review" } } },
      "then": {
        "properties": {
          "revisionHash": { "$ref": "#/$defs/digest" },
          "localizations": { "minItems": 1 },
          "preflight": { "properties": { "blockers": { "maxItems": 0 } } }
        }
      },
      "else": {
        "properties": {
          "revisionHash": { "type": "null" },
          "localizations": { "maxItems": 0 },
          "preflight": { "properties": { "blockers": { "minItems": 1 } } }
        }
      }
    }
  ],
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ref" }
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
