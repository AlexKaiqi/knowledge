{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/xiaohongshu/community-rule-surface-output.schema.json",
  "title": "XiaohongshuCommunityRuleSurface",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "title", "publishedAt", "sections", "ruleHeadingCount", "obligations", "observedAt", "semanticDigest", "conformance"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url"],
      "properties": {
        "id": { "const": "xiaohongshu-community-rules-2" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "title": { "type": "string", "minLength": 1 },
    "publishedAt": { "type": "string", "minLength": 1 },
    "sections": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "ruleHeadingCount": { "type": "integer", "minimum": 0 },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "documented"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "documented": { "type": "boolean" }
        }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "semanticDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assertions"],
      "properties": {
        "status": { "enum": ["passed", "review-required"] },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "passed": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
