{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "maven-central-public-jar-release-maintainer",
  "version": "1.0.0",
  "scope": {
    "knowledgeGlobs": [
      "knowledge/platforms/maven-central.md",
      "knowledge/concepts/maven-central/public-jar-release-evidence.md",
      "knowledge/capabilities/maven-central/read-public-jar-release-evidence.md",
      "knowledge/schemas/maven-central/read-public-jar-release-evidence-*.schema.json",
      "knowledge/verifications/maven-central/public-jar-release/*.json"
    ],
    "connectorIds": ["maven-central-public-jar-release"],
    "capabilityRefs": ["/capabilities/maven-central/read-public-jar-release-evidence.md"]
  },
  "triggers": [
    { "kind": "schedule", "schedule": "55 7 * * *" },
    { "kind": "source-change" },
    { "kind": "schema-change" },
    { "kind": "connector-change" },
    { "kind": "failed-execution" },
    { "kind": "manual" }
  ],
  "execution": {
    "kind": "deterministic",
    "runtime": "node >=22.19",
    "entrypoint": "collectors/maven-central-public-jar-release-maintainer/src/index.mjs"
  },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": { "mode": "proposal-only", "requiresApprovalFor": ["knowledge", "connector", "live-probe"] },
  "probePolicy": { "allowedEnvironments": ["production-public"], "identityPoolRefs": [], "maximumEffect": "none" },
  "budgets": { "maxRunsPerDay": 2, "maxCostPerDay": 0, "currency": "CNY" }
}
