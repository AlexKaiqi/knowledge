{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/xiaohongshu/account-api-surface-output.schema.json",
  "title": "XiaohongshuAccountApiSurface",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "transport", "endpoints", "documentedOperationFamilies", "notDocumentedInThisReference", "safetyRequirements", "observedAt", "semanticDigest", "conformance"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "title"],
      "properties": {
        "id": { "const": "xiaohongshu-account-api-reference" },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "contentType", "productionBaseUrl", "testBaseUrl"],
      "properties": {
        "method": { "const": "POST" },
        "contentType": { "const": "application/json" },
        "productionBaseUrl": { "type": "string", "format": "uri" },
        "testBaseUrl": { "type": "string", "format": "uri" }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "id", "title", "path"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^/api/sns/v1/oauth2/" }
        }
      }
    },
    "documentedOperationFamilies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "notDocumentedInThisReference": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "safetyRequirements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "observedAt": { "type": "string", "format": "date-time" },
    "semanticDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assertions", "missingExpectedPaths", "undocumentedPaths"],
      "properties": {
        "status": { "enum": ["passed", "review-required"] },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "passed": { "type": "boolean" }
            }
          }
        },
        "missingExpectedPaths": { "type": "array", "items": { "type": "string" } },
        "undocumentedPaths": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
