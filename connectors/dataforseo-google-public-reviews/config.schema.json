{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/dataforseo-google-public-reviews-config.schema.json",
  "title": "DataForSeoGooglePublicReviewsConnectorConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000, "default": 30000 },
    "maxResponseBytes": { "type": "integer", "minimum": 262144, "maximum": 8388608, "default": 4194304 },
    "taskResultDeadlineSeconds": { "const": 2700, "default": 2700 },
    "maximumSubmittedTasks": { "const": 1, "default": 1 },
    "maximumReviews": { "const": 20, "default": 20 },
    "maximumCostUsd": { "const": 0.002, "default": 0.002 }
  }
}
