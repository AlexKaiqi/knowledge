{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "coresignal-job-posting-snapshot-maintainer",
  "version": "0.1.0",
  "scope": {
    "knowledgeGlobs": [
      "knowledge/capabilities/research/read-job-posting-snapshot.md",
      "knowledge/concepts/research/job-posting-snapshot.md",
      "knowledge/schemas/research/read-job-posting-snapshot-*.schema.json",
      "knowledge/verifications/research/job-posting-snapshot/*.json"
    ],
    "connectorIds": ["coresignal-job-posting-snapshot"],
    "capabilityRefs": ["/capabilities/research/read-job-posting-snapshot.md"]
  },
  "triggers": [
    { "kind": "schedule", "schedule": "20 9 * * 2,5" },
    { "kind": "source-change" },
    { "kind": "schema-change" },
    { "kind": "connector-change" },
    { "kind": "failed-execution" },
    { "kind": "manual" }
  ],
  "execution": {
    "kind": "deterministic",
    "runtime": "node >=22.19",
    "entrypoint": "collectors/coresignal-job-posting-snapshot-maintainer/src/index.mjs"
  },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": {
    "mode": "proposal-only",
    "requiresApprovalFor": ["knowledge", "connector", "identity", "credential", "live-probe"]
  },
  "probePolicy": {
    "allowedEnvironments": ["production-public"],
    "identityPoolRefs": ["identity-pool:coresignal-provider-probes"],
    "maximumEffect": "financial"
  },
  "budgets": { "maxRunsPerDay": 2, "maxCostPerDay": 0, "currency": "USD" }
}
