{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "nuget-org-public-package-version-maintainer",
  "version": "1.0.0",
  "scope": {
    "knowledgeGlobs": [
      "knowledge/platforms/nuget-org.md",
      "knowledge/concepts/nuget-org/public-package-version-evidence.md",
      "knowledge/capabilities/nuget-org/read-public-package-version-evidence.md",
      "knowledge/schemas/nuget-org/read-public-package-version-evidence-*.schema.json",
      "knowledge/verifications/nuget-org/public-package-version/*.json"
    ],
    "connectorIds": ["nuget-org-public-package-version"],
    "capabilityRefs": ["/capabilities/nuget-org/read-public-package-version-evidence.md"]
  },
  "triggers": [
    { "kind": "schedule", "schedule": "20 8 * * *" },
    { "kind": "source-change" },
    { "kind": "schema-change" },
    { "kind": "connector-change" },
    { "kind": "failed-execution" },
    { "kind": "manual" }
  ],
  "execution": {
    "kind": "deterministic",
    "runtime": "node >=22.19",
    "entrypoint": "collectors/nuget-org-public-package-version-maintainer/src/index.mjs"
  },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": { "mode": "proposal-only", "requiresApprovalFor": ["knowledge", "connector", "live-probe"] },
  "probePolicy": { "allowedEnvironments": ["production-public"], "identityPoolRefs": [], "maximumEffect": "none" },
  "budgets": { "maxRunsPerDay": 2, "maxCostPerDay": 0, "currency": "CNY" }
}
