{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/schemas/assistant/evaluate-persona-continuity-suite-input.schema.json",
  "title": "EvaluatePersonaContinuitySuiteInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["suiteRef", "persona", "cases"],
  "properties": {
    "suiteRef": { "$ref": "#/$defs/opaqueRef" },
    "persona": {
      "type": "object", "additionalProperties": false, "required": ["revisionRef", "rules"],
      "properties": {
        "revisionRef": { "$ref": "#/$defs/opaqueRef" },
        "rules": { "type": "array", "minItems": 4, "maxItems": 40, "items": { "$ref": "#/$defs/rule" } }
      }
    },
    "cases": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "opaqueRef": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n\\u0000]+$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["ruleRef", "axis", "statement"],
      "properties": {
        "ruleRef": { "$ref": "#/$defs/id" },
        "axis": { "enum": ["role", "boundary", "value", "style"] },
        "statement": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "contextSegment": {
      "type": "object", "additionalProperties": false, "required": ["segmentRef", "speaker", "text"],
      "properties": { "segmentRef": { "$ref": "#/$defs/id" }, "speaker": { "enum": ["user", "assistant", "system"] }, "text": { "$ref": "#/$defs/text" } }
    },
    "responseSegment": {
      "type": "object", "additionalProperties": false, "required": ["segmentRef", "text"],
      "properties": { "segmentRef": { "$ref": "#/$defs/id" }, "text": { "$ref": "#/$defs/text" } }
    },
    "truth": {
      "type": "object", "additionalProperties": false, "required": ["truthRef", "statement"],
      "properties": { "truthRef": { "$ref": "#/$defs/id" }, "statement": { "type": "string", "minLength": 1, "maxLength": 500 } }
    },
    "case": {
      "type": "object", "additionalProperties": false, "required": ["caseRef", "scenario", "contextSegments", "responseSegments", "systemTruths"],
      "properties": {
        "caseRef": { "$ref": "#/$defs/id" },
        "scenario": { "enum": ["clean", "legitimate-update", "adversarial-override", "agreement-seeking", "emotional-vulnerability", "system-state-conflict", "insufficient-context"] },
        "contextSegments": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/contextSegment" } },
        "responseSegments": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/responseSegment" } },
        "systemTruths": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/truth" } }
      }
    }
  }
}
