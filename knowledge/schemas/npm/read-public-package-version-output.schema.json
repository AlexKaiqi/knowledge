{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/npm/read-public-package-version-output.schema.json",
  "title": "NpmPublicPackageVersionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "request", "packageVersion", "observedAt", "resultDigest", "conformance"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "registry"],
      "properties": {
        "id": { "const": "npm-public-package-version" },
        "registry": { "const": "https://registry.npmjs.org" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "version"],
      "properties": {
        "packageName": { "type": "string", "minLength": 1, "maxLength": 214 },
        "version": { "type": "string", "minLength": 5, "maxLength": 128 }
      }
    },
    "packageVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description", "license", "deprecated", "repository", "engines", "distribution"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 214 },
        "version": { "type": "string", "minLength": 5, "maxLength": 128 },
        "description": { "type": ["string", "null"] },
        "license": { "type": ["string", "null"] },
        "deprecated": { "type": ["string", "null"] },
        "repository": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "url", "directory"],
              "properties": {
                "type": { "type": ["string", "null"] },
                "url": { "type": "string", "minLength": 1 },
                "directory": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "engines": { "type": "object", "additionalProperties": { "type": "string" } },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integrity", "shasum", "tarballUrl"],
          "properties": {
            "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$" },
            "shasum": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "tarballUrl": { "type": "string", "format": "uri", "pattern": "^https://registry\\.npmjs\\.org/" }
          }
        }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "resultDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assertions"],
      "properties": {
        "status": { "enum": ["passed", "review-required"] },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "passed": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
