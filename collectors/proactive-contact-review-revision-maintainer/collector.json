{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "proactive-contact-review-revision-maintainer",
  "version": "1.0.0",
  "scope": {
    "knowledgeGlobs": ["knowledge/tools/proactive-contact-review-revision.md", "knowledge/concepts/assistant/proactive-contact-review-revision.md", "knowledge/capabilities/assistant/prepare-proactive-contact-review-revision.md", "knowledge/schemas/assistant/prepare-proactive-contact-review-revision-*.schema.json", "knowledge/verifications/assistant/proactive-contact-review-revision/*.json"],
    "connectorIds": ["proactive-contact-review-revision"], "capabilityRefs": ["/capabilities/assistant/prepare-proactive-contact-review-revision.md"]
  },
  "triggers": [{ "kind": "schedule", "schedule": "0 11 * * 3" }, { "kind": "source-change" }, { "kind": "schema-change" }, { "kind": "connector-change" }, { "kind": "failed-execution" }, { "kind": "manual" }],
  "execution": { "kind": "deterministic", "runtime": "node >=22.19", "entrypoint": "collectors/proactive-contact-review-revision-maintainer/src/index.mjs" },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": { "mode": "proposal-only", "requiresApprovalFor": ["knowledge", "connector", "live-probe"] },
  "probePolicy": { "allowedEnvironments": ["local", "production-public"], "identityPoolRefs": [], "maximumEffect": "none" },
  "budgets": { "maxRunsPerDay": 2, "maxCostPerDay": 0, "currency": "CNY" }
}
