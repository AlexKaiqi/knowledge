{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "xiaohongshu-account-docs-maintainer",
  "version": "1.0.0",
  "scope": {
    "knowledgeGlobs": [
      "knowledge/sources/xiaohongshu-account-api.md",
      "knowledge/concepts/xiaohongshu/account-api-surface.md",
      "knowledge/capabilities/xiaohongshu/read-account-api-surface.md",
      "knowledge/schemas/xiaohongshu/account-api-*.schema.json",
      "knowledge/verifications/xiaohongshu/account-api/*.json"
    ],
    "connectorIds": ["xiaohongshu-account-docs"],
    "capabilityRefs": ["/capabilities/xiaohongshu/read-account-api-surface.md"]
  },
  "triggers": [
    { "kind": "schedule", "schedule": "20 5 * * *" },
    { "kind": "source-change" },
    { "kind": "connector-change" },
    { "kind": "failed-execution" },
    { "kind": "manual" }
  ],
  "execution": {
    "kind": "deterministic",
    "runtime": "node >=22.19",
    "entrypoint": "collectors/xiaohongshu-account-docs-maintainer/src/index.mjs"
  },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": {
    "mode": "proposal-only",
    "requiresApprovalFor": ["knowledge", "connector", "live-probe"]
  },
  "probePolicy": {
    "allowedEnvironments": ["production-public"],
    "identityPoolRefs": [],
    "maximumEffect": "none"
  },
  "budgets": { "maxRunsPerDay": 4, "maxCostPerDay": 0, "currency": "CNY" }
}
