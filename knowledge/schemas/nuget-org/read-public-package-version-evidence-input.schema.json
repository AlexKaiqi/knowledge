{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/nuget-org/read-public-package-version-evidence-input.schema.json",
  "title": "ReadNuGetOrgPublicPackageVersionEvidenceInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["packageId", "version"],
  "properties": {
    "packageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(?!.*(?:\\.\\.|--))[A-Za-z0-9_](?:[A-Za-z0-9_.-]{0,98}[A-Za-z0-9_])?$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:\\.(?:[1-9][0-9]*))?(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  }
}
