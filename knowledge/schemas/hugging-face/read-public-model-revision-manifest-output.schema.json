{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/hugging-face/read-public-model-revision-manifest-output.schema.json",
  "title": "HuggingFacePublicModelRevisionManifestResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "request", "modelRevision", "rateLimit", "observedAt", "resultDigest", "conformance"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "apiOrigin", "endpointTemplate"],
      "properties": {
        "id": { "const": "hugging-face-public-model-revision" },
        "apiOrigin": { "const": "https://huggingface.co" },
        "endpointTemplate": { "const": "https://huggingface.co/api/models/{repoId}/revision/{commitSha}?blobs=true" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoId", "commitSha"],
      "properties": {
        "repoId": { "type": "string", "minLength": 3, "maxLength": 96, "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*/[A-Za-z0-9_][A-Za-z0-9._-]*$" },
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "modelRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoId", "commitSha", "visibility", "gated", "disabled", "pipelineTag", "libraryName", "tags", "manifestComplete", "fileCount", "totalSizeBytes", "fileManifestDigest", "files"],
      "properties": {
        "repoId": { "type": "string", "minLength": 3, "maxLength": 96 },
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "visibility": { "const": "public" },
        "gated": { "const": false },
        "disabled": { "const": false },
        "pipelineTag": { "type": ["string", "null"], "maxLength": 256 },
        "libraryName": { "type": ["string", "null"], "maxLength": 256 },
        "tags": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "manifestComplete": { "const": true },
        "fileCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "totalSizeBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "fileManifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sizeBytes", "storage", "gitBlobSha1", "lfsSha256", "xetHash"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "sizeBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "storage": { "enum": ["git", "lfs", "xet"] },
              "gitBlobSha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
              "lfsSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
              "xetHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
            },
            "allOf": [
              { "if": { "properties": { "storage": { "const": "git" } } }, "then": { "properties": { "lfsSha256": { "type": "null" }, "xetHash": { "type": "null" } } } },
              { "if": { "properties": { "storage": { "const": "lfs" } } }, "then": { "properties": { "lfsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "xetHash": { "type": "null" } } } },
              { "if": { "properties": { "storage": { "const": "xet" } } }, "then": { "properties": { "lfsSha256": { "type": "null" }, "xetHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } }
            ]
          }
        }
      }
    },
    "rateLimit": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["bucket", "limit", "remaining", "windowSeconds", "resetAfterSeconds", "resetAt"],
          "properties": {
            "bucket": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$",
              "maxLength": 64
            },
            "limit": { "type": "integer", "minimum": 1 },
            "remaining": { "type": "integer", "minimum": 0 },
            "windowSeconds": { "type": "integer", "minimum": 1 },
            "resetAfterSeconds": { "type": "integer", "minimum": 0 },
            "resetAt": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "resultDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assertions"],
      "properties": {
        "status": { "enum": ["passed", "review-required"] },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "passed": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
