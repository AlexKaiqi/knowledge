{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/web-feeds/read-registered-public-feed-output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "request", "feed", "coverage", "entries", "transport", "observedAt", "resultDigest", "conformance"],
  "properties": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "feedUrl", "homeUrl", "format"],
      "properties": {
        "id": { "const": "nodejs-releases" },
        "feedUrl": { "const": "https://nodejs.org/en/feed/releases.xml" },
        "homeUrl": { "const": "https://nodejs.org/en" },
        "format": { "const": "rss-2.0" }
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["feedId", "limit"],
      "properties": { "feedId": { "const": "nodejs-releases" }, "limit": { "type": "integer", "minimum": 1, "maximum": 20 } }
    },
    "feed": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "language", "updatedAt", "feedDigest", "documentSha256"],
      "properties": {
        "title": { "const": "Node.js Blog: Releases" },
        "language": { "const": "en" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "feedDigest": { "$ref": "#/$defs/sha256" },
        "documentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["documentEntryCount", "returnedCount", "maximumDocumentEntries", "returnedComplete"],
      "properties": {
        "documentEntryCount": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "returnedCount": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maximumDocumentEntries": { "const": 1000 },
        "returnedComplete": { "type": "boolean" }
      }
    },
    "entries": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/entry" } },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["contentType", "receivedBytes", "etag", "lastModified"],
      "properties": {
        "contentType": { "enum": ["application/rss+xml", "application/atom+xml", "application/xml", "text/xml", null] },
        "receivedBytes": { "type": "integer", "minimum": 1, "maximum": 524288 },
        "etag": { "type": ["string", "null"], "maxLength": 512 },
        "lastModified": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "resultDigest": { "$ref": "#/$defs/sha256" },
    "conformance": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "assertions"],
      "properties": {
        "status": { "enum": ["passed", "review-required"] },
        "assertions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "passed"], "properties": { "id": { "type": "string" }, "passed": { "type": "boolean" } } } }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "url", "publishedAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://nodejs\\.org/en/blog/release/" },
        "publishedAt": { "type": ["string", "null"], "format": "date-time" },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
