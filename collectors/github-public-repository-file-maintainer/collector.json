{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "github-public-repository-file-maintainer",
  "version": "1.0.0",
  "scope": {
    "knowledgeGlobs": [
      "knowledge/platforms/github.md",
      "knowledge/concepts/github/public-repository-file.md",
      "knowledge/capabilities/github/read-public-repository-file.md",
      "knowledge/schemas/github/read-public-repository-file-*.schema.json",
      "knowledge/verifications/github/public-repository-file/*.json"
    ],
    "connectorIds": ["github-public-repository-file"],
    "capabilityRefs": ["/capabilities/github/read-public-repository-file.md"]
  },
  "triggers": [
    { "kind": "schedule", "schedule": "45 6 * * *" },
    { "kind": "source-change" },
    { "kind": "schema-change" },
    { "kind": "connector-change" },
    { "kind": "failed-execution" },
    { "kind": "manual" }
  ],
  "execution": {
    "kind": "deterministic",
    "runtime": "node >=22.19",
    "entrypoint": "collectors/github-public-repository-file-maintainer/src/index.mjs"
  },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": { "mode": "proposal-only", "requiresApprovalFor": ["knowledge", "connector", "live-probe"] },
  "probePolicy": { "allowedEnvironments": ["production-public"], "identityPoolRefs": [], "maximumEffect": "none" },
  "budgets": { "maxRunsPerDay": 4, "maxCostPerDay": 0, "currency": "CNY" }
}
