{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/steam/prepare-initial-release-date-review-revision-input.schema.json",
  "title": "PrepareSteamInitialReleaseDateReviewRevisionInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["gameRef", "sourceRevisionRef", "storeRevisionRef", "buildRevisionRef", "observedReleaseState", "target"],
  "properties": {
    "gameRef": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,191}$" },
    "sourceRevisionRef": { "$ref": "#/$defs/ref" },
    "storeRevisionRef": { "$ref": "#/$defs/ref" },
    "buildRevisionRef": { "$ref": "#/$defs/ref" },
    "observedReleaseState": { "$ref": "#/$defs/observed" },
    "target": { "$ref": "#/$defs/target" }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "refs": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "displayMode": { "enum": ["exact-date", "month-year", "quarter", "year", "coming-soon"] },
    "reviewState": { "enum": ["not-submitted", "in-review", "changes-requested", "ready-for-release"] },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "releaseState", "specifiedReleaseDate", "playerFacingDisplay", "comingSoonPublishedDate", "storePresenceReviewState", "buildReviewState", "evidenceRefs"],
      "properties": {
        "observedAt": { "type": "string", "format": "date-time" },
        "releaseState": { "enum": ["not-released", "released"] },
        "specifiedReleaseDate": { "type": "string", "format": "date" },
        "playerFacingDisplay": { "$ref": "#/$defs/displayMode" },
        "comingSoonPublishedDate": { "type": ["string", "null"], "format": "date" },
        "storePresenceReviewState": { "$ref": "#/$defs/reviewState" },
        "buildReviewState": { "$ref": "#/$defs/reviewState" },
        "evidenceRefs": { "$ref": "#/$defs/refs" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specifiedReleaseDate", "playerFacingDisplay", "decisionEvidenceRefs"],
      "properties": {
        "specifiedReleaseDate": { "type": "string", "format": "date" },
        "playerFacingDisplay": { "$ref": "#/$defs/displayMode" },
        "decisionEvidenceRefs": { "$ref": "#/$defs/refs" }
      }
    }
  }
}
