{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/schemas/feedback/withdraw-consented-intake-record-input.schema.json",
  "title": "Withdraw consented feedback intake record input",
  "type": "object",
  "additionalProperties": false,
  "required": ["storeRef", "storageReceiptRef", "recordDigest", "withdrawalRequestRef", "withdrawalMechanismRef", "withdrawalGrantRef", "idempotencyKey"],
  "properties": {
    "storeRef": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$" },
    "storageReceiptRef": { "$ref": "#/$defs/opaqueRef" },
    "recordDigest": { "$ref": "#/$defs/digest" },
    "withdrawalRequestRef": { "$ref": "#/$defs/opaqueRef" },
    "withdrawalMechanismRef": { "$ref": "#/$defs/opaqueRef" },
    "withdrawalGrantRef": { "$ref": "#/$defs/opaqueRef" },
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
  },
  "$defs": {
    "opaqueRef": { "type": "string", "minLength": 1, "maxLength": 500 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
