{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/schemas/assistant/ground-memory-into-action-candidate-input.schema.json",
  "title": "Ground memory into action candidate input",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "explicitArguments", "memoryClaims", "now"],
  "properties": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "effect", "scopeRef", "fields"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "effect": { "enum": ["none", "local-write", "platform-write", "financial", "communication", "identity-relationship"] },
        "scopeRef": { "type": "string", "minLength": 1, "maxLength": 240 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "type", "required", "memoryPolicy"],
            "properties": {
              "path": { "$ref": "#/$defs/fieldPath" },
              "type": { "enum": ["string", "number", "integer", "boolean"] },
              "required": { "type": "boolean" },
              "memoryPolicy": { "enum": ["explicit-only", "allow-user-confirmed", "allow-confirmed-or-verified"] },
              "enumValues": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/scalar" }
              }
            }
          }
        }
      }
    },
    "explicitArguments": {
      "type": "object",
      "maxProperties": 50,
      "additionalProperties": { "$ref": "#/$defs/scalar" }
    },
    "memoryClaims": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "actionName", "scopeRef", "fieldPath", "value", "authority", "lifecycle", "observedAt", "provenanceRefs"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "actionName": { "$ref": "#/$defs/id" },
          "scopeRef": { "type": "string", "minLength": 1, "maxLength": 240 },
          "fieldPath": { "$ref": "#/$defs/fieldPath" },
          "value": { "$ref": "#/$defs/scalar" },
          "authority": { "enum": ["user-confirmed", "tool-verified", "assistant-inferred"] },
          "lifecycle": { "enum": ["active", "contested", "superseded"] },
          "observedAt": { "type": "string", "format": "date-time" },
          "validUntil": { "type": "string", "format": "date-time" },
          "provenanceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      }
    },
    "now": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "fieldPath": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$" },
    "scalar": {
      "oneOf": [
        { "type": "string", "maxLength": 2000 },
        { "type": "number" },
        { "type": "boolean" }
      ]
    }
  }
}
