{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/assistant/maintain-current-work-projection-input.schema.json",
  "title": "Maintain current work projection input",
  "type": "object",
  "additionalProperties": false,
  "required": ["currentSessionRef", "workspaceRef", "instruction", "acceptUnconfirmedKnowledgeProposals"],
  "properties": {
    "currentSessionRef": { "type": "string", "pattern": "^session:[A-Za-z0-9._-]{1,128}$" },
    "workspaceRef": { "type": "string", "pattern": "^workspace:[A-Za-z0-9._-]{1,128}$" },
    "instruction": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "acceptUnconfirmedKnowledgeProposals": { "const": true }
  }
}
