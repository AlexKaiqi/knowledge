{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "durable-memory-change-review-revision-maintainer",
  "version": "1.0.0",
  "scope": {
    "knowledgeGlobs": [
      "knowledge/tools/durable-memory-change-review-revision.md",
      "knowledge/concepts/assistant/durable-memory-change-review-revision.md",
      "knowledge/capabilities/assistant/prepare-durable-memory-change-review-revision.md",
      "knowledge/schemas/assistant/prepare-durable-memory-change-review-revision-*.schema.json",
      "knowledge/verifications/assistant/durable-memory-change-review-revision/*.json"
    ],
    "connectorIds": ["durable-memory-change-review-revision"],
    "capabilityRefs": ["/capabilities/assistant/prepare-durable-memory-change-review-revision.md"]
  },
  "triggers": [
    { "kind": "schedule", "schedule": "55 10 * * 3" }, { "kind": "source-change" }, { "kind": "schema-change" },
    { "kind": "connector-change" }, { "kind": "failed-execution" }, { "kind": "manual" }
  ],
  "execution": { "kind": "deterministic", "runtime": "node >=22.19", "entrypoint": "collectors/durable-memory-change-review-revision-maintainer/src/index.mjs" },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": { "mode": "proposal-only", "requiresApprovalFor": ["knowledge", "connector", "live-probe"] },
  "probePolicy": { "allowedEnvironments": ["local", "production-public"], "identityPoolRefs": [], "maximumEffect": "none" },
  "budgets": { "maxRunsPerDay": 2, "maxCostPerDay": 0, "currency": "CNY" }
}
