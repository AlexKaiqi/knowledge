{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/connectors/maven-central-public-jar-release/config.schema.json",
  "title": "MavenCentralPublicJarReleaseConnectorConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 60000, "default": 20000 },
    "userAgent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+ \\((https://[^()\\s]+|[^()\\s@]+@[^()\\s@]+)\\)$"
    }
  }
}
