{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/schemas/feedback/expire-consented-intake-record-output.schema.json",
  "title": "Feedback intake retention deletion receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "retentionDeletionReceiptRef", "storeRef", "storageReceiptRef", "intakeRevisionHash", "recordDigest", "retentionPolicyRef", "deleteAfter", "retentionGrantReceiptRef", "deletedAt", "idempotencyKey", "replayed", "recordPresent", "retentionDeletionApplied", "withdrawalApplied", "mediaSanitized", "backupsPurged", "downstreamCopiesDeleted", "replySent", "platformWritten", "knowledgeWritten", "executionAuthorized"],
  "properties": {
    "schemaVersion": { "const": "dsh.feedback-intake-retention-deletion-receipt/v1" },
    "status": { "const": "expired-and-deleted" },
    "retentionDeletionReceiptRef": { "$ref": "#/$defs/opaqueRef" },
    "storeRef": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$" },
    "storageReceiptRef": { "$ref": "#/$defs/opaqueRef" },
    "intakeRevisionHash": { "$ref": "#/$defs/digest" },
    "recordDigest": { "$ref": "#/$defs/digest" },
    "retentionPolicyRef": { "$ref": "#/$defs/opaqueRef" },
    "deleteAfter": { "type": "string", "format": "date-time" },
    "retentionGrantReceiptRef": { "$ref": "#/$defs/opaqueRef" },
    "deletedAt": { "type": "string", "format": "date-time" },
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "replayed": { "type": "boolean" },
    "recordPresent": { "const": false },
    "retentionDeletionApplied": { "const": true },
    "withdrawalApplied": { "const": false },
    "mediaSanitized": { "const": false },
    "backupsPurged": { "const": false },
    "downstreamCopiesDeleted": { "const": false },
    "replySent": { "const": false },
    "platformWritten": { "const": false },
    "knowledgeWritten": { "const": false },
    "executionAuthorized": { "const": false }
  },
  "$defs": {
    "opaqueRef": { "type": "string", "minLength": 1, "maxLength": 500 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
