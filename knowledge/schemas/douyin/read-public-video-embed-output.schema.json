{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/douyin/read-public-video-embed-output.schema.json",
  "title": "DouyinPublicVideoEmbedResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "request", "videoEmbed", "observedAt", "resultDigest", "conformance"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "apiOrigin", "endpointTemplate", "accessClass"],
      "properties": {
        "id": { "const": "douyin-public-video-embed" },
        "apiOrigin": { "const": "https://open.douyin.com" },
        "endpointTemplate": { "const": "https://open.douyin.com/api/douyin/v1/video/get_iframe_by_video?video_id={videoId}" },
        "accessClass": { "const": "official-public-no-permission" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["videoId"],
      "properties": {
        "videoId": { "type": "string", "minLength": 1, "maxLength": 19, "pattern": "^[1-9][0-9]{0,18}$" }
      }
    },
    "videoEmbed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["videoId", "title", "width", "height", "playerUrl"],
      "properties": {
        "videoId": { "type": "string", "minLength": 1, "maxLength": 19, "pattern": "^[1-9][0-9]{0,18}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "width": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "height": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "playerUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://open\\.douyin\\.com/player/video\\?vid=[1-9][0-9]{0,18}&autoplay=0$"
        }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "resultDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assertions"],
      "properties": {
        "status": { "enum": ["passed", "review-required"] },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "passed": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
