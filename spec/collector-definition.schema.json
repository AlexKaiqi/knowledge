{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/collector-definition.schema.json",
  "title": "CollectorDefinition",
  "description": "A hidden maintenance controller for OKF knowledge and connector conformance; not a pagination/data-ingestion abstraction.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "scope", "triggers", "execution", "outputs", "writePolicy", "probePolicy", "budgets"],
  "properties": {
    "schemaVersion": { "const": "dsh.collector-definition/v1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "minLength": 1 },
    "projectCatalogRef": { "$ref": "#/$defs/repositoryRef" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledgeGlobs", "connectorIds", "capabilityRefs"],
      "properties": {
        "knowledgeGlobs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "connectorIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "capabilityRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/localRef" } }
      }
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["schedule", "source-change", "schema-change", "connector-change", "failed-execution", "manual"] },
          "schedule": { "type": "string", "minLength": 1 }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runtime", "entrypoint"],
      "properties": {
        "kind": { "enum": ["deterministic", "agentic", "hybrid"] },
        "runtime": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "pattern": "^collectors/[a-z0-9._-]+/[^/].+$" },
        "modelRouteRef": { "type": "string", "minLength": 1 },
        "promptRef": { "type": "string", "minLength": 1 },
        "toolRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evalRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["agentic", "hybrid"] } }, "required": ["kind"] },
          "then": { "required": ["modelRouteRef", "promptRef", "evalRefs"] }
        }
      ]
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["knowledge-proposal", "connector-change-proposal", "verification-report"] }
    },
    "writePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "requiresApprovalFor"],
      "properties": {
        "mode": { "const": "proposal-only" },
        "requiresApprovalFor": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["knowledge", "connector", "identity", "credential", "live-probe"] } }
      }
    },
    "probePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedEnvironments", "identityPoolRefs", "maximumEffect"],
      "properties": {
        "allowedEnvironments": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["local", "sandbox", "production-private"] } },
        "identityPoolRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^identity-pool:[a-z0-9]+(?:[._-][a-z0-9]+)*$" } },
        "maximumEffect": { "enum": ["none", "local-write", "platform-write", "financial", "communication", "identity-relationship"] }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRunsPerDay", "maxCostPerDay"],
      "properties": {
        "maxRunsPerDay": { "type": "integer", "minimum": 1 },
        "maxCostPerDay": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "localRef": { "type": "string", "pattern": "^/(?!/)(?!.*\\.\\.)[^?#]+$" },
    "repositoryRef": { "type": "string", "pattern": "^repo:/(?!/)(?!.*\\.\\.)[^?#]+$" }
  }
}
