{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/knowledge-admission-policy.schema.json",
  "title": "KnowledgeAdmissionPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requirePassedReport", "requireFreshReport", "requireFreshKnowledge", "requireSources", "requireVerified", "rejectOrphans", "valueAlignment", "subjectTypes"],
  "properties": {
    "schemaVersion": { "const": "dsh.knowledge-admission-policy/v1" },
    "requirePassedReport": { "const": true },
    "requireFreshReport": { "const": true },
    "requireFreshKnowledge": { "const": true },
    "requireSources": { "const": true },
    "requireVerified": { "const": true },
    "rejectOrphans": { "const": true },
    "valueAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityOutcomeField", "acceptedOutcomeDomains", "rejectGenericInfrastructure"],
      "properties": {
        "capabilityOutcomeField": { "const": "outcomes" },
        "acceptedOutcomeDomains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["demand-discovery", "product-research", "content-publishing", "app-publishing", "research-publishing", "distribution", "feedback-collection", "influence-measurement"] }
        },
        "rejectGenericInfrastructure": { "const": true }
      }
    },
    "subjectTypes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptedVerificationLevels"],
        "properties": {
          "acceptedVerificationLevels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["local", "sandbox", "live"] }
          }
        }
      }
    }
  }
}
