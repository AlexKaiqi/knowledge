{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/coresignal-job-posting-snapshot-config.schema.json",
  "title": "CoresignalJobPostingSnapshotConnectorConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000, "default": 30000 },
    "maxResponseBytes": { "type": "integer", "minimum": 65536, "maximum": 4194304, "default": 2097152 },
    "maxCreditsPerInvocation": { "const": 10, "default": 10 },
    "userAgent": { "type": "string", "minLength": 1, "maxLength": 128, "default": "dsh-knowledge-catalog/0.1" }
  }
}
