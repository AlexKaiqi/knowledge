{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/connectors/xiaohongshu-browser/config.schema.json",
  "title": "XiaohongshuBrowserConnectorConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["stateRoot"],
  "properties": {
    "routeId": {
      "enum": ["owned-notes-xiaohongshu-mcp", "creator-web-xiaohongshu-mcp", "creator-web-xiaohongshu-skill"],
      "default": "creator-web-xiaohongshu-mcp"
    },
    "baseUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^http://(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::[0-9]+)?/?$"
    },
    "stateRoot": {
      "type": "string",
      "minLength": 1,
      "description": "Private, non-Git operation ledger root."
    },
    "skillRuntimeRoot": {
      "type": "string",
      "pattern": "^/",
      "description": "Private local runtime containing the pinned and reviewed xiaohongshu-skill checkout."
    },
    "profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "description": "Opaque local account-profile binding; never a username or credential."
    },
    "requestTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 },
    "verificationTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
    "verificationPollMs": { "type": "integer", "minimum": 250, "maximum": 30000 }
  },
  "allOf": [
    {
      "if": { "properties": { "routeId": { "const": "creator-web-xiaohongshu-skill" } }, "required": ["routeId"] },
      "then": { "required": ["skillRuntimeRoot", "profile"] },
      "else": { "required": ["baseUrl"] }
    }
  ]
}
