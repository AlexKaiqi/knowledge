{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/schemas/assistant/prepare-proactive-contact-review-revision-output.schema.json",
  "title": "Proactive contact review revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ownerScopeRef", "policy", "state", "candidate", "policySemanticsRevision", "status", "reviewRevisionHash", "suppressionReasons", "preflight", "reviewItems", "reviewerDecision", "notificationSent", "messageCreated", "deliveryAttempted", "executionAuthorized", "preparedAt"],
  "properties": {
    "schemaVersion": { "const": "dsh.proactive-contact-review-revision/v1" }, "ownerScopeRef": { "$ref": "#/$defs/ref" },
    "policy": { "$ref": "#/$defs/policy" }, "state": { "$ref": "#/$defs/state" }, "candidate": { "$ref": "#/$defs/candidate" },
    "policySemanticsRevision": { "const": "proactive-contact-policy-2026-08-27" }, "status": { "enum": ["eligible-for-human-review", "suppressed", "blocked"] },
    "reviewRevisionHash": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "suppressionReasons": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "enum": ["not-opted-in", "paused", "visible-in-source", "not-yet-available", "recent-user-activity", "minimum-gap", "daily-cap", "unanswered-cap", "quiet-hours", "duplicate-recent-contact"] } },
    "preflight": { "type": "object", "additionalProperties": false, "required": ["blockers"], "properties": { "blockers": { "type": "array", "maxItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["code"], "properties": { "code": { "const": "candidate-expired" } } } } } },
    "reviewItems": { "type": "array", "maxItems": 7, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": { "id": { "enum": ["basis-and-user-benefit", "timing-and-interruption", "copy-and-sensitive-data", "exact-surfaces-and-audience", "duplicate-and-current-context", "snooze-dismiss-and-disable", "expiry-and-cancel"] }, "status": { "const": "pending" } } } },
    "reviewerDecision": { "type": "null" }, "notificationSent": { "const": false }, "messageCreated": { "const": false }, "deliveryAttempted": { "const": false }, "executionAuthorized": { "const": false },
    "preparedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "eligible-for-human-review" } }, "required": ["status"] }, "then": { "properties": { "reviewRevisionHash": { "$ref": "#/$defs/digest" }, "suppressionReasons": { "maxItems": 0 }, "preflight": { "properties": { "blockers": { "maxItems": 0 } } }, "reviewItems": { "minItems": 7 } } } },
    { "if": { "properties": { "status": { "const": "suppressed" } }, "required": ["status"] }, "then": { "properties": { "reviewRevisionHash": { "type": "null" }, "suppressionReasons": { "minItems": 1 }, "preflight": { "properties": { "blockers": { "maxItems": 0 } } }, "reviewItems": { "maxItems": 0 } } } },
    { "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] }, "then": { "properties": { "reviewRevisionHash": { "type": "null" }, "preflight": { "properties": { "blockers": { "minItems": 1 } } }, "reviewItems": { "maxItems": 0 } } } }
  ],
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 500 }, "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "refs": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } }, "dateOrNull": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "quietWindow": { "type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": { "start": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" }, "end": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" } } },
    "policy": { "type": "object", "additionalProperties": false, "required": ["optedIn", "pausedUntil", "timeZone", "quietWindows", "minimumGapMinutes", "maximumPerDay", "maximumConsecutiveUnanswered", "recentActivitySuppressionMinutes", "dedupeWindowMinutes"], "properties": { "optedIn": { "type": "boolean" }, "pausedUntil": { "$ref": "#/$defs/dateOrNull" }, "timeZone": { "type": "string", "minLength": 1, "maxLength": 100 }, "quietWindows": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/quietWindow" } }, "minimumGapMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 }, "maximumPerDay": { "type": "integer", "minimum": 1, "maximum": 20 }, "maximumConsecutiveUnanswered": { "type": "integer", "minimum": 1, "maximum": 20 }, "recentActivitySuppressionMinutes": { "type": "integer", "minimum": 0, "maximum": 1440 }, "dedupeWindowMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 } } },
    "dedupeObservation": { "type": "object", "additionalProperties": false, "required": ["key", "observedAt"], "properties": { "key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$" }, "observedAt": { "type": "string", "format": "date-time" } } },
    "state": { "type": "object", "additionalProperties": false, "required": ["evaluatedAt", "sentToday", "consecutiveUnanswered", "lastProactiveContactAt", "lastUserActivityAt", "recentDedupeObservations"], "properties": { "evaluatedAt": { "type": "string", "format": "date-time" }, "sentToday": { "type": "integer", "minimum": 0, "maximum": 100 }, "consecutiveUnanswered": { "type": "integer", "minimum": 0, "maximum": 100 }, "lastProactiveContactAt": { "$ref": "#/$defs/dateOrNull" }, "lastUserActivityAt": { "$ref": "#/$defs/dateOrNull" }, "recentDedupeObservations": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/dedupeObservation" } } } },
    "candidate": { "type": "object", "additionalProperties": false, "required": ["candidateRef", "kind", "dedupeKey", "basis", "evidenceRefs", "consequenceRefs", "surfaceRefs", "availableFrom", "expiresAt", "visibleInSourceNow", "copy"], "properties": { "candidateRef": { "$ref": "#/$defs/ref" }, "kind": { "enum": ["reminder", "follow-up", "check-in", "briefing", "status-update"] }, "dedupeKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$" }, "basis": { "type": "string", "minLength": 1, "maxLength": 1000 }, "evidenceRefs": { "$ref": "#/$defs/refs" }, "consequenceRefs": { "$ref": "#/$defs/refs" }, "surfaceRefs": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } }, "availableFrom": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time" }, "visibleInSourceNow": { "type": "boolean" }, "copy": { "type": "object", "additionalProperties": false, "required": ["title", "body"], "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 120 }, "body": { "type": "string", "minLength": 1, "maxLength": 500 } } } } }
  }
}
