{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/schemas/assistant/observe-multi-turn-response-repetition-output.schema.json",
  "title": "ObserveMultiTurnResponseRepetitionOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suiteRef", "policy", "summary", "cases", "interpretation", "retention", "observedAt", "personaChanged", "memoryChanged", "platformDataRead", "actionExecuted", "executionAuthorized", "resultDigest", "conformance"],
  "properties": {
    "schemaVersion": { "const": "dsh.multi-turn-response-repetition-observation/v1" },
    "suiteRef": { "$ref": "#/$defs/opaqueRef" },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["revisionRef", "normalizationProfile", "tokenizerRuntime", "ngramSizes", "comparisonScope", "thresholdsApplied"],
      "properties": {
        "revisionRef": { "const": "multi-turn-response-repetition-observation-2026-08-27" },
        "normalizationProfile": { "const": "intl-word-segmentation-nfkc-lowercase-emoji-v1" },
        "tokenizerRuntime": { "type": "string", "pattern": "^node-intl-icu-[0-9.]+$" },
        "ngramSizes": { "const": [2, 3] },
        "comparisonScope": { "const": "prior-assistant-responses-in-supplied-case" },
        "thresholdsApplied": { "const": false }
      }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "cases": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/resultCase" } },
    "interpretation": {
      "type": "object", "additionalProperties": false,
      "required": ["declaredContextsAreCallerClaims", "semanticRepetitionEvaluated", "responseQualityInferred", "personaContinuityInferred", "companionshipOutcomeInferred", "humanReviewRequired"],
      "properties": {
        "declaredContextsAreCallerClaims": { "const": true }, "semanticRepetitionEvaluated": { "const": false },
        "responseQualityInferred": { "const": false }, "personaContinuityInferred": { "const": false },
        "companionshipOutcomeInferred": { "const": false }, "humanReviewRequired": { "const": true }
      }
    },
    "retention": { "const": "input-text-ephemeral-output-digests-locators-and-lexical-counts-only" },
    "observedAt": { "type": "string", "format": "date-time" },
    "personaChanged": { "const": false }, "memoryChanged": { "const": false }, "platformDataRead": { "const": false },
    "actionExecuted": { "const": false }, "executionAuthorized": { "const": false },
    "resultDigest": { "$ref": "#/$defs/digest" },
    "conformance": {
      "type": "object", "additionalProperties": false, "required": ["status", "assertions"],
      "properties": {
        "status": { "enum": ["passed", "review-required"] },
        "assertions": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "passed"], "properties": { "id": { "$ref": "#/$defs/id" }, "passed": { "type": "boolean" } } } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "opaqueRef": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n\\u0000]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "metric": {
      "type": "object", "additionalProperties": false, "required": ["status", "total", "repeated", "fraction"],
      "properties": {
        "status": { "enum": ["no-history", "unavailable", "observed"] }, "total": { "type": "integer", "minimum": 0 },
        "repeated": { "type": "integer", "minimum": 0 }, "fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "aggregateMetric": {
      "type": "object", "additionalProperties": false, "required": ["comparableResponses", "total", "repeated", "fraction"],
      "properties": {
        "comparableResponses": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 },
        "repeated": { "type": "integer", "minimum": 0 }, "fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "repeatContext": {
      "type": "object", "additionalProperties": false, "required": ["currentResponseRef", "priorResponseRef", "kind", "evidenceRefs"],
      "properties": {
        "currentResponseRef": { "$ref": "#/$defs/id" }, "priorResponseRef": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["requested-repeat", "confirmation-readback", "repair-or-correction", "safety-boundary", "persona-catchphrase", "other-reviewed-context"] },
        "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/opaqueRef" } }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["responseRef", "responseDigest", "tokenCount", "historyResponseRefs", "exactPriorResponseRefs", "overlapPriorResponseRefs", "repeatContexts", "bigram", "trigram"],
      "properties": {
        "responseRef": { "$ref": "#/$defs/id" }, "responseDigest": { "$ref": "#/$defs/digest" }, "tokenCount": { "type": "integer", "minimum": 0 },
        "historyResponseRefs": { "$ref": "#/$defs/idList" }, "exactPriorResponseRefs": { "$ref": "#/$defs/idList" }, "overlapPriorResponseRefs": { "$ref": "#/$defs/idList" },
        "repeatContexts": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/repeatContext" } },
        "bigram": { "$ref": "#/$defs/metric" }, "trigram": { "$ref": "#/$defs/metric" }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["caseCount", "responseCount", "exactRepeatPairCount", "contextualizedExactRepeatPairCount", "uncontextualizedExactRepeatPairCount", "declaredRepeatContextPairCount", "bigram", "trigram"],
      "properties": {
        "caseCount": { "type": "integer", "minimum": 1 }, "responseCount": { "type": "integer", "minimum": 2 },
        "exactRepeatPairCount": { "type": "integer", "minimum": 0 }, "contextualizedExactRepeatPairCount": { "type": "integer", "minimum": 0 },
        "uncontextualizedExactRepeatPairCount": { "type": "integer", "minimum": 0 }, "declaredRepeatContextPairCount": { "type": "integer", "minimum": 0 },
        "bigram": { "$ref": "#/$defs/aggregateMetric" }, "trigram": { "$ref": "#/$defs/aggregateMetric" }
      }
    },
    "caseSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["exactRepeatPairCount", "contextualizedExactRepeatPairCount", "uncontextualizedExactRepeatPairCount", "declaredRepeatContextPairCount", "bigram", "trigram"],
      "properties": {
        "exactRepeatPairCount": { "type": "integer", "minimum": 0 }, "contextualizedExactRepeatPairCount": { "type": "integer", "minimum": 0 },
        "uncontextualizedExactRepeatPairCount": { "type": "integer", "minimum": 0 }, "declaredRepeatContextPairCount": { "type": "integer", "minimum": 0 },
        "bigram": { "$ref": "#/$defs/aggregateMetric" }, "trigram": { "$ref": "#/$defs/aggregateMetric" }
      }
    },
    "resultCase": {
      "type": "object", "additionalProperties": false, "required": ["caseRef", "locale", "responseCount", "summary", "observations"],
      "properties": {
        "caseRef": { "$ref": "#/$defs/id" }, "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
        "responseCount": { "type": "integer", "minimum": 2, "maximum": 20 }, "summary": { "$ref": "#/$defs/caseSummary" },
        "observations": { "type": "array", "minItems": 2, "maxItems": 20, "items": { "$ref": "#/$defs/observation" } }
      }
    }
  }
}
