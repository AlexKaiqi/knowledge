{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/steam/prepare-store-tag-review-revision-output.schema.json",
  "title": "SteamStoreTagReviewRevision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gameRef", "sourceRevisionRef", "catalogRevisionRef", "audienceEvidenceRefs", "policyRevision", "manualReview", "platformValidated", "savedToSteamworks", "published", "markedReadyForReview", "released", "executionAuthorized", "preparedAt", "status", "revisionHash", "tags", "preflight"],
  "properties": {
    "schemaVersion": { "const": "dsh.steam-store-tag-review-revision/v1" },
    "gameRef": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,191}$" },
    "sourceRevisionRef": { "$ref": "#/$defs/ref" },
    "catalogRevisionRef": { "$ref": "#/$defs/ref" },
    "audienceEvidenceRefs": { "$ref": "#/$defs/refs" },
    "policyRevision": { "const": "steam-store-tags-2026-08-27" },
    "status": { "enum": ["ready-for-human-review", "blocked"] },
    "revisionHash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tagRef", "displayName", "launchEvidenceRefs", "rank", "topFive"],
        "properties": {
          "tagRef": { "$ref": "#/$defs/ref" },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 160 },
          "launchEvidenceRefs": { "$ref": "#/$defs/refs" },
          "rank": { "type": "integer", "minimum": 1, "maximum": 20 },
          "topFive": { "type": "boolean" }
        }
      }
    },
    "manualReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "checks"],
      "properties": {
        "required": { "const": true },
        "checks": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": { "enum": ["current-platform-tag-availability", "top-five-clear-picture", "tag-relevance-and-specificity", "ordering-and-discovery-intent", "launch-build-consistency", "audience-evidence-quality", "owned-target-authority"] },
              "status": { "const": "pending" }
            }
          }
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "blockers"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": { "enum": ["official-tag-count", "unique-tag-refs", "unique-tag-names", "launch-evidence-bound", "ordered-top-five-present"] },
              "status": { "enum": ["passed", "failed"] }
            }
          }
        },
        "blockers": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": { "enum": ["tag-count-below-minimum", "tag-count-above-maximum", "duplicate-tag-ref", "duplicate-tag-name"] },
              "minimum": { "type": "integer", "minimum": 1 },
              "maximum": { "type": "integer", "minimum": 1 },
              "observed": { "type": "integer", "minimum": 0 },
              "tagRef": { "$ref": "#/$defs/ref" },
              "displayName": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "platformValidated": { "const": false },
    "savedToSteamworks": { "const": false },
    "published": { "const": false },
    "markedReadyForReview": { "const": false },
    "released": { "const": false },
    "executionAuthorized": { "const": false },
    "preparedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ready-for-human-review" } } },
      "then": {
        "properties": {
          "revisionHash": { "$ref": "#/$defs/digest" },
          "tags": { "minItems": 5, "maxItems": 20 },
          "preflight": { "properties": { "blockers": { "maxItems": 0 } } }
        }
      },
      "else": {
        "properties": {
          "revisionHash": { "type": "null" },
          "tags": { "maxItems": 0 },
          "preflight": { "properties": { "blockers": { "minItems": 1 } } }
        }
      }
    }
  ],
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "refs": { "type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
