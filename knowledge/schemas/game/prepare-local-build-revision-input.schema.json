{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/knowledge/schemas/game/prepare-local-build-revision-input.schema.json",
  "title": "Prepare local game build revision input",
  "type": "object",
  "additionalProperties": false,
  "required": ["gameRef", "version", "target", "releaseLane", "visibilityIntent", "sourceDirectory", "entrypoints", "sourceRevisionRef", "rightsBasisRefs"],
  "properties": {
    "gameRef": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,191}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "target": { "enum": ["desktop-portable", "steam-content-root", "itch-portable", "web-build"] },
    "releaseLane": { "enum": ["internal", "beta", "release-candidate", "production"] },
    "visibilityIntent": { "enum": ["owner-only", "restricted", "public"] },
    "sourceDirectory": { "$ref": "#/$defs/relativePath" },
    "entrypoints": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
    "sourceRevisionRef": { "$ref": "#/$defs/opaqueRef" },
    "rightsBasisRefs": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/opaqueRef" } },
    "releaseNotesRef": { "$ref": "#/$defs/opaqueRef" }
  },
  "allOf": [
    {
      "if": { "properties": { "target": { "enum": ["desktop-portable", "itch-portable"] } }, "required": ["target"] },
      "then": { "properties": { "entrypoints": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "target": { "const": "web-build" } }, "required": ["target"] },
      "then": { "properties": { "entrypoints": { "contains": { "const": "index.html" } } } }
    }
  ],
  "$defs": {
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$" },
    "opaqueRef": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
