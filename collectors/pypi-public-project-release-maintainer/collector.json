{
  "schemaVersion": "dsh.collector-definition/v1",
  "id": "pypi-public-project-release-maintainer",
  "version": "1.0.0",
  "scope": {
    "knowledgeGlobs": [
      "knowledge/platforms/pypi.md",
      "knowledge/concepts/pypi/public-project-release-metadata.md",
      "knowledge/capabilities/pypi/read-public-project-release.md",
      "knowledge/schemas/pypi/read-public-project-release-*.schema.json",
      "knowledge/verifications/pypi/public-project-release/*.json"
    ],
    "connectorIds": ["pypi-public-project-release"],
    "capabilityRefs": ["/capabilities/pypi/read-public-project-release.md"]
  },
  "triggers": [
    { "kind": "schedule", "schedule": "45 7 * * *" },
    { "kind": "source-change" },
    { "kind": "schema-change" },
    { "kind": "connector-change" },
    { "kind": "failed-execution" },
    { "kind": "manual" }
  ],
  "execution": {
    "kind": "deterministic",
    "runtime": "node >=22.19",
    "entrypoint": "collectors/pypi-public-project-release-maintainer/src/index.mjs"
  },
  "outputs": ["knowledge-proposal", "connector-change-proposal", "verification-report"],
  "writePolicy": { "mode": "proposal-only", "requiresApprovalFor": ["knowledge", "connector", "live-probe"] },
  "probePolicy": { "allowedEnvironments": ["production-public"], "identityPoolRefs": [], "maximumEffect": "none" },
  "budgets": { "maxRunsPerDay": 4, "maxCostPerDay": 0, "currency": "CNY" }
}
